<div class="bg-card border border-border rounded-xl p-6 sm:p-8 mb-8">

  {/* NOW SECTION */}
  <div class="mb-6">
    <h3 class="text-sm font-medium text-primary uppercase tracking-wider mb-3">Ahora</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <p class="text-lg font-bold text-fg">1</p>
        <p class="text-sm text-muted">Semana actual</p>
      </div>
      <div>
        <p class="text-sm text-muted">Desarrollo semanal</p>
      </div>
    </div>
  </div>

  {/* PROXIMAMENTE SECTION */}
  <div>
    <h3 class="text-sm font-medium text-primary uppercase tracking-wider mb-3">Próximamente</h3>
    <p class="text-sm text-muted">Desarrollo semanal continuo</p>
  </div>

  {/* CTA SECTION */}
  <div class="mt-8 pt-8 border-t border-border">
    <p class="text-sm text-muted mb-3">Esta información es orientativa y no sustituye las indicaciones de tu matrona, obstetra u otro profesional sanitario.</p>
    <a
      class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white font-medium px-6 py-3 rounded-xl transition-colors no-underline"
    >
      ¿Tienes dudas?
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Consúltalo con tu profesional sanitario
    </a>
  </div>

<script>
  // Valor inicial - se mostrará 1 hasta que el cliente se hidrate
  let displayWeek = 1;

  // Datos de milestones (usarán displayWeek=1 al inicio)
  const milestones = [
    { weekStart: 1, weekEnd: 4, title: 'Primeros signos', description: 'Síntomas tempranos' },
    { weekStart: 5, weekEnd: 8, title: 'Desarrollo embrionario', description: 'Desarrollo embrionario' },
    { weekStart: 9, weekEnd: 12, title: 'Primer trimestre', description: 'Primer trimestre' },
    { weekStart: 13, weekEnd: 16, title: 'Segundo trimestre', description: 'Segundo trimestre' },
    { weekStart: 17, weekEnd: 20, title: 'Hitos del segundo trimestre', description: 'Hitos segundo trimestre' },
    { weekStart: 21, weekEnd: 24, title: 'Desarrollo fetal', description: 'Desarrollo fetal' },
    { weekStart: 25, weekEnd: 28, title: 'Tercer trimestre', description: 'Tercer trimestre' },
    { weekStart: 29, weekEnd: 32, title: ' Preparación para el parto', description: 'Preparación parto' },
    { weekStart: 33, weekEnd: 36, title: 'Primeras señales', description: 'Primeras señales' },
    { weekStart: 37, weekEnd: 40, title: 'Termino del embarazo', description: 'Termino embarazo' },
    { weekStart: 41, weekEnd: 42, title: 'Semanas post termino', description: 'Post termino' }
  ] as const;

  // Funciones para encontrar hitos
  function findCurrentMilestone(week: number): { title: string; description: string } | null {
    const m = milestones.find(x => week >= x.weekStart && week <= x.weekEnd);
    return m ? { title: m.title, description: m.description } : null;
  }

  function findNextMilestones(week: number): Array<{ title: string; description: string }> {
    const next = milestones.filter(m => m.weekStart > week);
    return next.slice(0, 2);
  }

  // **LECTURA DE LOCALSTORAGE EN EL CLIENTE**
  // Este código se ejecuta después de la hidratación de Astro en el navegador
  if (typeof localStorage !== 'undefined') {
    try {
      const storedWeek = localStorage.getItem('mi-embarazo-cyl-state');
      if (storedWeek) {
        const parsed = JSON.parse(storedWeek);
        if (parsed.semana && parsed.semana > 0) {
          // Actualizar la variable displayWeek
          displayWeek = parsed.semana;
          // Forzar actualización del elemento HTML que muestra la semana
          // Buscamos el elemento que tiene la clase week-display o el primer p text-lg
          const weekDisplay = document.querySelector('p.text-lg.font-bold.text-fg');
          if (weekDisplay) {
            weekDisplay.textContent = parsed.semana;
          }
          // También actualizar la función de hito actual
          const currentMilestone = findCurrentMilestone(parsed.semana);
          if (currentMilestone) {
            // Podemos actualizar el texto de descripción si es necesario
            console.log('Semana actualizada a:', parsed.semana, 'Hito:', currentMilestone.title);
          }
        }
      }
    } catch (e) {
      // Error al parsear localStorage, mantener valor actual
    }
  }
</script>
</div>