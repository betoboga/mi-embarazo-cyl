---
interface Props {
  title: string;
  message: string;
  icon?: string;
}

const { title, message, icon = "info" } = Astro.props;

const icons: Record<string, string> = {
  info: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  search: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
  alert: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z",
};
---
<div class="text-center py-16 px-6">
  <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 mb-6">
    <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d={icons[icon] || icons.info} />
    </svg>
  </div>
  <h3 class="text-lg font-semibold text-fg mb-2">{title}</h3>
  <p class="text-muted text-sm max-w-sm mx-auto leading-relaxed">{message}</p>
</div>
