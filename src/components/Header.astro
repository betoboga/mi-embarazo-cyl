---
const currentPath = Astro.url.pathname;
const isArabic = currentPath.startsWith('/ar');
const isEnglish = currentPath.startsWith('/en');
const pagePath = isArabic ? currentPath.replace(/^\/ar/, '') || '/' : isEnglish ? currentPath.replace(/^\/en/, '') || '/' : currentPath;
const localizedPath = (path: string) => `${isArabic ? '/ar' : isEnglish ? '/en' : ''}${path === '/' ? '/' : path}`;
---
<header class="sticky top-0 z-50 bg-card/85 backdrop-blur-md border-b border-border">
  <nav class="max-w-3xl mx-auto px-4 h-14 flex items-center justify-between">
    <a href={localizedPath('/')} class="flex items-center gap-2 text-fg font-semibold text-lg no-underline">
      <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
      <span class="hidden sm:inline tracking-tight">CyLMaterna</span>
    </a>
    <div class="flex items-center gap-1">
      <a href={localizedPath('/donde-vive')} class:list={[
        "px-2 sm:px-3 py-1.5 rounded-lg text-sm font-medium transition-colors no-underline",
        pagePath.startsWith('/donde-vive') ? "bg-primary/10 text-primary" : "text-muted hover:text-fg hover:bg-bg-subtle"
      ]}>Zona</a>
      <a href={localizedPath('/recursos-cerca')} class:list={[
        "px-2 sm:px-3 py-1.5 rounded-lg text-sm font-medium transition-colors no-underline",
        pagePath.startsWith('/recursos-cerca') ? "bg-primary/10 text-primary" : "text-muted hover:text-fg hover:bg-bg-subtle"
      ]}>Recursos</a>
      <a href={localizedPath('/mi-embarazo')} class:list={[
        "px-2 sm:px-3 py-1.5 rounded-lg text-sm font-medium transition-colors no-underline",
        pagePath.startsWith('/mi-embarazo') ? "bg-primary/10 text-primary" : "text-muted hover:text-fg hover:bg-bg-subtle"
      ]}>Embarazo</a>
           <a href={localizedPath('/estadisticas')} class:list={[
        "px-3 py-1.5 rounded-lg text-sm font-medium transition-colors no-underline",
        pagePath.startsWith('/estadisticas') ? "bg-primary/10 text-primary" : "text-muted hover:text-fg hover:bg-bg-subtle"
      ]}>Datos</a>
      <a href={`${pagePath === '/' ? '/' : pagePath}`} class="px-1.5 sm:px-2 py-1.5 rounded-lg text-sm font-medium text-muted hover:text-fg hover:bg-bg-subtle transition-colors no-underline" lang="es">ES</a>
      <a href={`/ar${pagePath === '/' ? '/' : pagePath}`} class="px-1.5 sm:px-2 py-1.5 rounded-lg text-sm font-medium text-muted hover:text-fg hover:bg-bg-subtle transition-colors no-underline" lang="ar">ع</a>
      <a href={`/en${pagePath === '/' ? '/' : pagePath}`} class="px-1.5 sm:px-2 py-1.5 rounded-lg text-sm font-medium text-muted hover:text-fg hover:bg-bg-subtle transition-colors no-underline" lang="en">EN</a>
    </div>
  </nav>
</header>
