---
const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-border">
  <nav class="max-w-3xl mx-auto px-4 h-14 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 text-fg font-semibold text-lg no-underline">
      <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
      <span class="hidden sm:inline">Mi Embarazo CYL</span>
    </a>
    <div class="flex items-center gap-1">
      <a href="/donde-vive" class:list={[
        "px-3 py-1.5 rounded-lg text-sm font-medium transition-colors no-underline",
        currentPath.startsWith('/donde-vive') ? "bg-primary/10 text-primary" : "text-muted hover:text-fg hover:bg-bg-subtle"
      ]}>Zona</a>
      <a href="/mi-embarazo" class:list={[
        "px-3 py-1.5 rounded-lg text-sm font-medium transition-colors no-underline",
        currentPath.startsWith('/mi-embarazo') ? "bg-primary/10 text-primary" : "text-muted hover:text-fg hover:bg-bg-subtle"
      ]}>Embarazo</a>
    </div>
  </nav>
</header>
