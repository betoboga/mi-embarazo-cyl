---
interface Props { title?: string }
const { title = 'Mi Embarazo CYL' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Recursos sanitarios y territoriales para el embarazo en Castilla y León." />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
