---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Donde vives - Mi Embarazo CYL">
  <Header />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-8 sm:py-12 w-full">
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-fg mb-2">Donde vives?</h1>
      <p class="text-muted">Selecciona tu municipio para descubrir tu zona sanitaria.</p>
    </div>

    <div class="relative mb-6">
      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
        <svg class="w-5 h-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="text"
        id="searchInput"
        placeholder="Escribe tu municipio..."
        autocomplete="off"
        class="w-full pl-11 pr-4 py-3.5 text-base bg-white border-2 border-border rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all"
      />
      <button id="clearBtn" class="absolute inset-y-0 right-0 pr-4 flex items-center text-muted hover:text-fg transition-colors hidden" aria-label="Limpiar">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div id="selectedCard" class="hidden bg-card border-2 border-primary rounded-xl p-5 mb-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs text-muted uppercase tracking-wider mb-1">Municipio seleccionado</p>
          <p class="text-lg font-semibold text-fg" id="selectedName"></p>
          <p class="text-sm text-muted" id="selectedProvince"></p>
        </div>
        <button id="changeBtn" class="text-sm text-primary hover:text-primary-dark font-medium">Cambiar</button>
      </div>
      <a href="/mi-zona" id="continueBtn" class="mt-4 w-full inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark text-white font-medium px-6 py-3 rounded-xl transition-colors no-underline text-center">
        Ver mi zona sanitaria
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <div id="resultsContainer" class="hidden">
      <p class="text-sm text-muted mb-3" id="resultsCount"></p>
      <ul id="resultsList" class="space-y-2" role="listbox"></ul>
    </div>

    <div id="emptyState" class="text-center py-12">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-bg-subtle mb-4">
        <svg class="w-7 h-7 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <p class="text-muted">Escribe al menos 2 caracteres para buscar.</p>
    </div>

    <div id="noResults" class="hidden text-center py-12">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-bg-subtle mb-4">
        <svg class="w-7 h-7 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="text-fg font-medium mb-1">Municipio no encontrado</p>
      <p class="text-sm text-muted">Comprueba la ortografia o prueba con otro municipio de Castilla y Leon.</p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import data from '../data/territorial.json';

  const municipios = (data as any).municipios as Array<{
    nombre: string;
    provincia: string;
    provinciaNombre: string;
    codigoZbs: string;
    zbsNombre: string;
  }>;

  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const clearBtn = document.getElementById('clearBtn') as HTMLButtonElement;
  const resultsContainer = document.getElementById('resultsContainer') as HTMLElement;
  const resultsList = document.getElementById('resultsList') as HTMLUListElement;
  const resultsCount = document.getElementById('resultsCount') as HTMLElement;
  const emptyState = document.getElementById('emptyState') as HTMLElement;
  const noResults = document.getElementById('noResults') as HTMLElement;
  const selectedCard = document.getElementById('selectedCard') as HTMLElement;
  const selectedName = document.getElementById('selectedName') as HTMLElement;
  const selectedProvince = document.getElementById('selectedProvince') as HTMLElement;
  const changeBtn = document.getElementById('changeBtn') as HTMLButtonElement;

  const STORAGE_KEY = 'mi-embarazo-cyl-state';

  function getStoredState() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    } catch { return {}; }
  }

  function saveState(municipio: any) {
    const current = getStoredState();
    const state = { ...current, municipio: municipio.nombre, provincia: municipio.provinciaNombre, codigoZbs: municipio.codigoZbs, zbsNombre: municipio.zbsNombre };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }

  const stored = getStoredState();
  if (stored.municipio) {
    showSelected(stored.municipio, stored.provincia);
  }

  let debounceTimer: ReturnType<typeof setTimeout>;

  searchInput.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    clearBtn.classList.toggle('hidden', q.length === 0);

    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      if (q.length < 2) {
        hideAll();
        emptyState.classList.remove('hidden');
        return;
      }

      const matches = municipios.filter(m => {
        const name = m.nombre.toLowerCase();
        return name.includes(q);
      }).slice(0, 50);

      if (matches.length === 0) {
        hideAll();
        noResults.classList.remove('hidden');
        return;
      }

      hideAll();
      resultsContainer.classList.remove('hidden');
      resultsCount.textContent = `${matches.length} municipio${matches.length !== 1 ? 's' : ''} encontrado${matches.length !== 1 ? 's' : ''}`;
      resultsList.innerHTML = '';

      matches.forEach(m => {
        const li = document.createElement('li');
        li.className = 'bg-white border border-border rounded-xl px-4 py-3 cursor-pointer hover:border-primary/40 hover:bg-primary/5 transition-all';
        li.setAttribute('role', 'option');
        li.innerHTML = `
          <p class="font-medium text-fg">${m.nombre}</p>
          <p class="text-sm text-muted">${m.provinciaNombre}</p>
        `;
        li.addEventListener('click', () => selectMunicipio(m));
        resultsList.appendChild(li);
      });
    }, 150);
  });

  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      searchInput.value = '';
      clearBtn.classList.add('hidden');
      hideAll();
      emptyState.classList.remove('hidden');
    }
  });

  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    clearBtn.classList.add('hidden');
    searchInput.focus();
    hideAll();
    emptyState.classList.remove('hidden');
  });

  changeBtn.addEventListener('click', () => {
    selectedCard.classList.add('hidden');
    searchInput.value = '';
    searchInput.focus();
    hideAll();
    emptyState.classList.remove('hidden');
  });

  function selectMunicipio(m: any) {
    saveState(m);
    searchInput.value = '';
    clearBtn.classList.add('hidden');
    hideAll();
    showSelected(m.nombre, m.provinciaNombre);
  }

  function showSelected(nombre: string, provincia: string) {
    selectedName.textContent = nombre;
    selectedProvince.textContent = provincia;
    selectedCard.classList.remove('hidden');
  }

  function hideAll() {
    resultsContainer.classList.add('hidden');
    emptyState.classList.add('hidden');
    noResults.classList.add('hidden');
  }
</script>
