---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const locale = Astro.url.pathname.startsWith('/en/') ? 'en' : Astro.url.pathname.startsWith('/ar/') ? 'ar' : 'es';
const confirmationPath = locale === 'es' ? '/gracias-recurso/' : `/${locale}/gracias-recurso/`;
---
<Layout title="Recursos cerca de ti - CyLMaterna" description="Directorio colaborativo de apoyo, actividades y ejercicio durante el embarazo y el posparto en Castilla y León.">
  <Header />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-10 sm:py-14 w-full">
    <header class="mb-10">
      <p class="text-sm font-semibold text-primary mb-2">Directorio colaborativo</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-fg mb-3">Recursos cerca de ti</h1>
      <p class="text-muted text-lg leading-relaxed">Asociaciones, grupos, servicios, actividades y ejercicio para acompañarte durante el embarazo y el posparto en Castilla y León.</p>
    </header>

    <section aria-labelledby="directorio-title" class="mb-12">
      <h2 id="directorio-title" class="text-2xl font-bold text-fg mb-4">Directorio</h2>
      <article class="bg-card border border-border rounded-xl p-6 sm:p-7 shadow-sm">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="inline-flex rounded-full bg-primary/10 px-3 py-1 text-sm font-semibold text-primary">Ávila</span>
          <span class="inline-flex rounded-full bg-secondary/15 px-3 py-1 text-sm font-semibold text-fg">Lactancia materna y apoyo a familias</span>
        </div>
        <h3 class="text-xl font-bold text-fg">AMALAV - Asociación de Madres Lactantes de Ávila</h3>
        <p class="mt-3 text-muted leading-relaxed">AMALAV trabaja para proteger y promover la lactancia materna como una forma óptima de alimentación para los bebés y como vínculo afectivo, y para acompañar a las familias presentes y futuras en este momento tan especial de sus vidas.</p>
        <a href="https://amalav.blogspot.com/?m=1" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 font-semibold text-primary hover:text-primary-dark no-underline">
          Visitar el recurso
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          <span class="sr-only">(se abre en una nueva pestaña)</span>
        </a>
      </article>
      <p class="mt-4 text-sm text-muted">El directorio seguirá creciendo con asociaciones, grupos, servicios y actividades revisados antes de publicarse.</p>
    </section>

    <section aria-labelledby="proponer-title" class="bg-card border-2 border-primary/20 rounded-xl p-6 sm:p-8">
      <h2 id="proponer-title" class="text-2xl font-bold text-fg mb-2">Propón un recurso</h2>
      <p class="text-muted mb-7">¿Conoces una asociación, grupo, servicio o actividad útil durante el embarazo o el posparto? Envíanos sus datos. Revisaremos la propuesta antes de publicarla.</p>
      <form id="resource-form" name="propuesta-recurso" method="POST" action={confirmationPath} data-netlify="true" netlify-honeypot="bot-field" class="space-y-5">
        <input type="hidden" name="form-name" value="propuesta-recurso" />
        <p class="hidden"><label>No rellenes este campo: <input name="bot-field" /></label></p>
        <div>
          <label for="nombre-recurso" class="block text-sm font-semibold text-fg mb-2">Nombre del recurso</label>
          <input id="nombre-recurso" name="nombre-recurso" required maxlength="120" autocomplete="organization" placeholder="Por ejemplo, pilates prenatal o un grupo de apoyo" class="w-full px-4 py-3 bg-white border-2 border-border rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10" />
        </div>
        <div>
          <label for="tipo-recurso" class="block text-sm font-semibold text-fg mb-2">Tipo de recurso</label>
          <select id="tipo-recurso" name="tipo-recurso" required class="w-full px-4 py-3 bg-white border-2 border-border rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10">
            <option value="">Selecciona un tipo</option>
            <option>Asociación, grupo o servicio de apoyo</option>
            <option>Pilates prenatal u otra actividad para embarazadas</option>
            <option>Matronatación o ejercicio acuático para embarazadas</option>
            <option>Ejercicio posparto</option>
            <option>Clases de preparación al parto</option>
            <option>Otro recurso</option>
          </select>
          <p class="text-xs text-muted mt-2">También puedes proponer otras actividades de ejercicio y bienestar durante el embarazo o el posparto.</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-5">
          <div><label for="municipio" class="block text-sm font-semibold text-fg mb-2">Municipio</label><input id="municipio" name="municipio" required maxlength="100" autocomplete="address-level2" placeholder="Municipio" class="w-full px-4 py-3 bg-white border-2 border-border rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10" /></div>
          <div><label for="provincia" class="block text-sm font-semibold text-fg mb-2">Provincia</label><select id="provincia" name="provincia" required class="w-full px-4 py-3 bg-white border-2 border-border rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10"><option value="">Selecciona una provincia</option><option>Ávila</option><option>Burgos</option><option>León</option><option>Palencia</option><option>Salamanca</option><option>Segovia</option><option>Soria</option><option>Valladolid</option><option>Zamora</option></select></div>
        </div>
        <div><label for="descripcion" class="block text-sm font-semibold text-fg mb-2">¿Qué ofrece?</label><textarea id="descripcion" name="descripcion" required maxlength="1000" rows="5" placeholder="Describe a quién va dirigido, qué ofrece y, si es una actividad, cuándo se realiza" class="w-full px-4 py-3 bg-white border-2 border-border rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10"></textarea></div>
        <div><label for="enlace" class="block text-sm font-semibold text-fg mb-2">Web o forma de contacto</label><input id="enlace" name="enlace" required maxlength="250" placeholder="Web, teléfono, correo o red social" class="w-full px-4 py-3 bg-white border-2 border-border rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10" /></div>
        <div><label for="email-contacto" class="block text-sm font-semibold text-fg mb-2">Tu correo electrónico</label><input id="email-contacto" type="email" name="email-contacto" required maxlength="160" autocomplete="email" placeholder="Solo lo usaremos si necesitamos aclarar la propuesta" class="w-full px-4 py-3 bg-white border-2 border-border rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10" /><p class="text-xs text-muted mt-2">No publicaremos tu correo electrónico.</p></div>
        <label class="flex items-start gap-3"><input type="checkbox" name="confirmacion" required class="mt-1 w-5 h-5 rounded border-border text-primary focus:ring-primary/20" /><span class="text-sm text-fg">Confirmo que la información es correcta y puede ser revisada para su publicación.</span></label>
        <button type="submit" class="w-full sm:w-auto bg-primary hover:bg-primary-dark text-white font-semibold px-7 py-3 rounded-xl transition-colors">Enviar propuesta</button>
      </form>
    </section>
  </main>
  <Footer />
  <script>
    const resourceForm = document.getElementById('resource-form') as HTMLFormElement | null;
    resourceForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!resourceForm.reportValidity()) return;
      const submitButton = resourceForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitButton) submitButton.disabled = true;
      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(resourceForm) as any).toString(),
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        window.location.assign(resourceForm.action);
      } catch {
        if (submitButton) submitButton.disabled = false;
        resourceForm.submit();
      }
    });
  </script>
</Layout>
