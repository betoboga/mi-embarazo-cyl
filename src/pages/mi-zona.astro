---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  obtenerFarmaciasConFallback,
  obtenerEstacionesMunicipio,
  obtenerHospitalesProvincia,
  obtenerCentrosConFallback,
  obtenerZbsMunicipio,
  obtenerMunicipio,
} from "../data/repository";
---

<Layout title="Tu zona sanitaria - Mi Embarazo CYL">
  <Header />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-8 sm:py-12 w-full">
    <div id="noState" class="hidden">
      <div
        class="bg-card border border-border rounded-xl p-6 sm:p-8 mx-auto text-center"
      >
        <h2 class="text-xl font-semibold text-fg mb-2">
          Selecciona un municipio
        </h2>
        <p class="text-muted">
          Elige tu municipio en la página principal para ver tus recursos
          sanitarios.
        </p>
        <a
          href="/donde-vive"
          class="mt-4 inline-block text-primary hover:text-primary-dark font-medium px-4 py-2 rounded-xl transition-colors"
          >Ir a donde vives</a
        >
      </div>
    </div>

    <div id="zonaContent" class="hidden">
      <div class="mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-fg mb-2">
          Tu zona sanitaria
        </h1>
        <p class="text-muted" id="subtitle"></p>
      </div>

      <div class="space-y-6">
        <div
          id="municipioBlock"
          class="bg-card border border-border rounded-xl p-6 sm:p-8 hidden"
        >
          <h3
            class="text-sm font-medium text-primary uppercase tracking-wider mb-4"
          >
            En tu municipio
          </h3>

          <div class="mb-6">
            <p class="text-xs text-muted uppercase tracking-wider mb-3">
              Farmacias
            </p>
            <div id="farmaciasList" class="space-y-3"></div>
            <button
              id="farmaciasVerMas"
              class="hidden mt-3 text-sm text-primary font-medium"
              >Ver todas</button
            >
          </div>

          <div>
            <p class="text-xs text-muted uppercase tracking-wider mb-3">
              Estaciones de autobús
            </p>
            <div id="estacionesList" class="space-y-3"></div>
          </div>
        </div>

        <div
          id="zbsBlock"
          class="bg-card border border-border rounded-xl p-6 sm:p-8 hidden"
        >
          <h3
            class="text-sm font-medium text-primary uppercase tracking-wider mb-3"
          >
            En tu Zona Básica
          </h3>
          <div id="zbsList" class="space-y-2"></div>
        </div>

        <div
          id="provinciaBlock"
          class="bg-bg-subtle border border-border rounded-xl p-6 sm:p-8 hidden"
        >
          <h3
            class="text-sm font-medium text-primary uppercase tracking-wider mb-4"
          >
            En tu provincia
          </h3>

          <div class="mb-6">
            <p class="text-xs text-muted uppercase tracking-wider mb-3">
              Hospitales
            </p>
            <div id="hospitalesList" class="space-y-3"></div>
          </div>

          <div>
            <p class="text-xs text-muted uppercase tracking-wider mb-3">
              Centros de salud
            </p>
            <div id="centrosList" class="space-y-3"></div>
            <button
              id="centrosVerMas"
              class="hidden mt-3 text-sm text-primary font-medium"
              >Ver más centros</button
            >
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import {
    obtenerFarmaciasConFallback,
    obtenerEstacionesMunicipio,
    obtenerHospitalesProvincia,
    obtenerCentrosConFallback,
    obtenerZbsMunicipio,
    obtenerMunicipio,
  } from "../data/repository";

  const STORAGE_KEY = "mi-embarazo-cyl-state";
  function getStoredState() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
    } catch {
      return {};
    }
  }

  function escapeHtml(s: string) {
    return (s || "").replace(
      /[&<>"']/g,
      (c) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[c] || c,
    );
  }

  // Tarjeta genérica reutilizable para un recurso
  function tarjeta(nombre: string, lineas: string[], telefono?: string) {
    const tel = telefono
      ? `<a href="tel:${telefono.replace(/\s+/g, "")}" class="inline-flex items-center gap-1 text-primary text-sm font-medium mt-1">📞 ${escapeHtml(telefono)}</a>`
      : "";
    return `
      <div class="bg-white border border-border rounded-lg p-4">
        <p class="font-semibold text-fg">${escapeHtml(nombre)}</p>
        ${lineas
          .filter(Boolean)
          .map(
            (l) => `<p class="text-sm text-muted mt-0.5">${escapeHtml(l)}</p>`,
          )
          .join("")}
        ${tel}
      </div>`;
  }

  const state = getStoredState();
  const noState = document.getElementById("noState") as HTMLElement;
  const zonaContent = document.getElementById("zonaContent") as HTMLElement;
  const municipioBlock = document.getElementById(
    "municipioBlock",
  ) as HTMLElement;
  const zbsBlock = document.getElementById("zbsBlock") as HTMLElement;
  const provinciaBlock = document.getElementById(
    "provinciaBlock",
  ) as HTMLElement;
  const subtitle = document.getElementById("subtitle") as HTMLParagraphElement;
  const farmaciasList = document.getElementById("farmaciasList") as HTMLElement;
  const farmaciasVerMas = document.getElementById(
    "farmaciasVerMas",
  ) as HTMLButtonElement;
  const estacionesList = document.getElementById(
    "estacionesList",
  ) as HTMLElement;
  const zbsList = document.getElementById("zbsList") as HTMLElement;
  const hospitalesList = document.getElementById(
    "hospitalesList",
  ) as HTMLElement;
  const centrosList = document.getElementById("centrosList") as HTMLElement;
  const centrosVerMas = document.getElementById(
    "centrosVerMas",
  ) as HTMLButtonElement;

  if (!state.municipio) {
    noState.classList.remove("hidden");
  } else {
    noState.classList.add("hidden");
    zonaContent.classList.remove("hidden");

    const munNombre = state.municipio || "Sin datos";
    const provNombre = state.provincia || "Sin datos";
    subtitle.textContent = `${munNombre}, ${provNombre}`;

    // FARMACIAS (con fallback a la ZBS si el municipio no tiene ninguna)
    const farmResult = obtenerFarmaciasConFallback(munNombre);
    const farmacias = farmResult.farmacias;
    if (farmacias.length === 0) {
      farmaciasList.innerHTML = `<p class="text-sm text-muted">No hay farmacias registradas en tu municipio ni en tu zona.</p>`;
    } else {
      const aviso =
        farmResult.nivel === "zona"
          ? `<p class="text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-lg p-3 mb-3">No hay farmacias en tu municipio. Estas son las más cercanas dentro de tu Zona Básica de Salud:</p>`
          : "";
      const LIMITE = 8;
      const renderFarmacias = (lista: typeof farmacias) => {
        farmaciasList.innerHTML =
          aviso +
          lista
            .map((f) =>
              tarjeta(
                f.nombre,
                [f.direccion, f.cp ? `CP ${f.cp}` : ""],
                f.telefono,
              ),
            )
            .join("");
      };
      renderFarmacias(farmacias.slice(0, LIMITE));
      if (farmacias.length > LIMITE) {
        farmaciasVerMas.textContent = `Ver todas (${farmacias.length})`;
        farmaciasVerMas.classList.remove("hidden");
        farmaciasVerMas.addEventListener("click", () => {
          renderFarmacias(farmacias);
          farmaciasVerMas.classList.add("hidden");
        });
      }
    }
    municipioBlock.classList.remove("hidden");

    // ESTACIONES DE BUS (sin campo nombre propio en los datos)
    const estaciones = obtenerEstacionesMunicipio(munNombre);
    if (estaciones.length === 0) {
      estacionesList.innerHTML = `<p class="text-sm text-muted">No hay estaciones de autobús registradas en tu municipio.</p>`;
    } else {
      estacionesList.innerHTML = estaciones
        .map((e) => tarjeta("Estación de autobuses", [e.direccion]))
        .join("");
    }

    // ZBS (sin cambios respecto a lo que ya funcionaba)
    const zbsResult = obtenerZbsMunicipio(munNombre);
    if (zbsResult && zbsResult.codigos.length > 0) {
      zbsList.innerHTML = zbsResult.codigos
        .map((code, i) => {
          const name = zbsResult.nombres[i] || `ZBS ${i + 1}`;
          return `<div class="bg-white p-2 rounded mb-1 text-sm"><strong>${code}</strong>: ${escapeHtml(name)}</div>`;
        })
        .join("");
    } else {
      zbsList.innerHTML = `<p class="text-sm text-muted">No disponible</p>`;
    }
    zbsBlock.classList.remove("hidden");

    // PROVINCIA
    const municipioObj = obtenerMunicipio(munNombre);
    const provCode = municipioObj?.provincia || "";

    // HOSPITALES (solo nombre + nivel, no hay dirección/teléfono reales)
    const hospitales = obtenerHospitalesProvincia(provCode);
    if (hospitales.length === 0) {
      hospitalesList.innerHTML = `<p class="text-sm text-muted">No hay hospitales registrados en tu provincia.</p>`;
    } else {
      hospitalesList.innerHTML = hospitales
        .map((h) => tarjeta(h.nombre, [h.nivel ? `Nivel ${h.nivel}` : ""]))
        .join("");
    }

    // CENTROS DE SALUD (municipio -> zona -> provincia, con aviso de nivel)
    const centrosResult = obtenerCentrosConFallback(munNombre, provCode);
    const centros = centrosResult.centros;
    const etiquetaNivel = {
      municipio: "en tu municipio",
      zona: "en tu Zona Básica",
      provincia: "en tu provincia",
    };
    if (centros.length === 0) {
      centrosList.innerHTML = `<p class="text-sm text-muted">No hay centros de salud con ubicación disponible cerca de ti.</p>`;
    } else {
      const aviso =
        centrosResult.nivel !== "municipio"
          ? `<p class="text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-lg p-3 mb-3">No hay centros de salud en tu municipio. Mostrando los disponibles ${etiquetaNivel[centrosResult.nivel]}:</p>`
          : "";
      const LIMITE_CENTROS = 8;
      const renderCentros = (lista: typeof centros) => {
        centrosList.innerHTML =
          aviso +
          lista
            .map((c) => tarjeta(c.nombre, [c.direccion, c.localidad, c.tipo]))
            .join("");
      };
      renderCentros(centros.slice(0, LIMITE_CENTROS));
      if (centros.length > LIMITE_CENTROS) {
        centrosVerMas.textContent = `Ver más (${centros.length} ${etiquetaNivel[centrosResult.nivel]})`;
        centrosVerMas.classList.remove("hidden");
        centrosVerMas.addEventListener("click", () => {
          renderCentros(centros);
          centrosVerMas.classList.add("hidden");
        });
      }
    }
    provinciaBlock.classList.remove("hidden");
  }
</script>
