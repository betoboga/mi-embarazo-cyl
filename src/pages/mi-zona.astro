---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  obtenerFarmaciasConFallback,
  obtenerEstacionesCercanas,
  obtenerHospitalesProvincia,
  obtenerHospitalesSanitariosProvincia,
  obtenerZbs,
  obtenerCentrosConFallback,
  obtenerZbsMunicipio,
  obtenerMunicipio,
} from "../data/repository";
---

<Layout title="Tu zona sanitaria - CyLMaterna">
  <Header />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-8 sm:py-12 w-full">
    <div id="noState" class="hidden">
      <div
        class="bg-card border border-border rounded-xl p-6 sm:p-8 mx-auto text-center"
      >
        <h2 class="text-xl font-semibold text-fg mb-2">
          Selecciona un municipio
        </h2>
        <p class="text-muted">
          Elige tu municipio en la página principal para ver tus recursos
          sanitarios.
        </p>
        <a
          href="/donde-vive"
          class="mt-4 inline-block text-primary hover:text-primary-dark font-medium px-4 py-2 rounded-xl transition-colors"
          >Ir a donde vives</a
        >
      </div>
    </div>

    <div id="zonaContent" class="hidden">
      <div class="mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-fg mb-2">
          Tu zona sanitaria
        </h1>
        <p class="text-muted" id="subtitle"></p>
      </div>

      <div class="space-y-6">
        <div
          id="municipioBlock"
          class="bg-card border border-border rounded-xl p-6 sm:p-8 hidden"
        >
          <h3
            class="text-sm font-medium text-primary uppercase tracking-wider mb-4"
          >
            En tu municipio
          </h3>

          <div class="mb-6">
            <p class="text-xs text-muted uppercase tracking-wider mb-3">
              Farmacias
            </p>
            <div id="farmaciasList" class="space-y-3"></div>
            <button
              id="farmaciasVerMas"
              class="hidden mt-3 text-sm text-primary font-medium"
              >Ver todas</button
            >
          </div>

          <div>
            <p class="text-xs text-muted uppercase tracking-wider mb-3">
              Estaciones de autobús
            </p>
            <div id="estacionesList" class="space-y-3"></div>
          </div>
        </div>

        <div
          id="zbsBlock"
          class="bg-card border border-border rounded-xl p-6 sm:p-8 hidden"
        >
          <h3
            class="text-sm font-medium text-primary uppercase tracking-wider mb-3"
          >
            En tu Zona Básica
          </h3>
          <div id="zbsList" class="space-y-2"></div>
        </div>

        <section
          id="guiaSinZbs"
          class="bg-secondary-light border border-secondary/20 rounded-xl p-6 sm:p-8 hidden"
          aria-labelledby="guiaSinZbsTitulo"
        >
          <h2 id="guiaSinZbsTitulo" class="text-lg font-semibold text-fg mb-3">
            No hemos encontrado una Zona Básica de Salud asignada
          </h2>
          <p class="text-sm text-muted leading-relaxed mb-5">
            No te preocupes. Puedes seguir estos pasos para saber dónde acudir
            durante tu embarazo:
          </p>
          <ol class="space-y-4 text-sm text-fg">
            <li class="flex gap-3">
              <span
                class="flex-none w-7 h-7 rounded-full bg-secondary text-white inline-flex items-center justify-center font-semibold"
                >1</span
              >
              <span
                ><strong>Consulta el mapa:</strong> localiza el centro de salud o
                consultorio más cercano a tu municipio.</span
              >
            </li>
            <li class="flex gap-3">
              <span
                class="flex-none w-7 h-7 rounded-full bg-secondary text-white inline-flex items-center justify-center font-semibold"
                >2</span
              >
              <span
                ><strong>Contacta con el centro:</strong> pregunta por la matrona
                y explica que estás embarazada para que te indiquen cómo pedir cita.</span
              >
            </li>
            <li class="flex gap-3">
              <span
                class="flex-none w-7 h-7 rounded-full bg-secondary text-white inline-flex items-center justify-center font-semibold"
                >3</span
              >
              <span
                ><strong>Prepara tu documentación:</strong> lleva tu tarjeta sanitaria
                y, si la tienes, la información de tu embarazo.</span
              >
            </li>
          </ol>
          <p
            class="mt-5 pt-4 border-t border-secondary/20 text-sm text-muted leading-relaxed"
          >
            Si tienes una urgencia médica, llama al <strong class="text-fg"
              >112</strong
            > o acude al servicio de urgencias más cercano.
          </p>
        </section>

        <div
          id="mapaBlock"
          class="bg-card border border-border rounded-xl p-6 sm:p-8 hidden"
        >
          <h3
            class="text-sm font-medium text-primary uppercase tracking-wider mb-4"
          >
            Mapa de tu zona
          </h3>
          <div
            id="map"
            class="w-full h-80 sm:h-96 rounded-xl overflow-hidden border border-border"
          >
          </div>
          <div class="flex gap-4 mt-3 text-xs text-muted">
            <span class="inline-flex items-center gap-1.5"
              ><span
                class="w-2.5 h-2.5 rounded-full inline-block"
                style="background:#0f766e"></span> Centros de salud</span
            >
            <span class="inline-flex items-center gap-1.5"
              ><span
                class="w-2.5 h-2.5 rounded-full inline-block"
                style="background:#d97706"></span> Tu centro de salud</span
            >
            <span class="inline-flex items-center gap-1.5"
              ><span
                class="w-2.5 h-2.5 rounded-full inline-block"
                style="background:#2563eb"></span> Estaciones de autobús</span
            >
            <span class="inline-flex items-center gap-1.5"
              ><span
                class="w-2.5 h-2.5 rounded-full inline-block"
                style="background:#dc2626"></span> Tu ubicación</span
            >
          </div>
        </div>

        <div
          id="provinciaBlock"
          class="bg-bg-subtle border border-border rounded-xl p-6 sm:p-8 hidden"
        >
          <h3
            class="text-sm font-medium text-primary uppercase tracking-wider mb-4"
          >
            En tu provincia
          </h3>

          <div class="mb-6">
            <p class="text-xs text-muted uppercase tracking-wider mb-3">
              Hospitales
            </p>
            <div id="hospitalesList" class="space-y-3"></div>
          </div>

          <div>
            <p class="text-xs text-muted uppercase tracking-wider mb-3">
              Centros de salud
            </p>
            <div id="centrosList" class="space-y-3"></div>
            <button
              id="centrosVerMas"
              class="hidden mt-3 text-sm text-primary font-medium"
              >Ver más centros</button
            >
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import {
    obtenerFarmaciasConFallback,
    obtenerHospitalesProvincia,
    obtenerHospitalesSanitariosProvincia,
    obtenerHospitalReferenciaParto,
    obtenerHospitalesReferenciaParto,
    obtenerZbs,
    obtenerCentrosConFallback,
    obtenerCentrosProvincia,
    obtenerZbsMunicipio,
    obtenerMunicipio,
    obtenerEstacionesCercanas,
  } from "../data/repository";

  const STORAGE_KEY = "mi-embarazo-cyl-state";
  function getStoredState() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
    } catch {
      return {};
    }
  }

  function escapeHtml(s: string) {
    return (s || "").replace(
      /[&<>"']/g,
      (c) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[c] || c,
    );
  }

  // Tarjeta genérica reutilizable para un recurso
  function tarjeta(nombre: string, lineas: string[], telefono?: string) {
    const tel = telefono
      ? `<a href="tel:${telefono.replace(/\s+/g, "")}" class="inline-flex items-center gap-1 text-primary text-sm font-medium mt-1">📞 ${escapeHtml(telefono)}</a>`
      : "";
    return `
      <div class="bg-white border border-border rounded-lg p-4">
        <p class="font-semibold text-fg">${escapeHtml(nombre)}</p>
        ${lineas
          .filter(Boolean)
          .map(
            (l) => `<p class="text-sm text-muted mt-0.5">${escapeHtml(l)}</p>`,
          )
          .join("")}
        ${tel}
      </div>`;
  }

  const state = getStoredState();
  const noState = document.getElementById("noState") as HTMLElement;
  const zonaContent = document.getElementById("zonaContent") as HTMLElement;
  const municipioBlock = document.getElementById(
    "municipioBlock",
  ) as HTMLElement;
  const zbsBlock = document.getElementById("zbsBlock") as HTMLElement;
  const guiaSinZbs = document.getElementById("guiaSinZbs") as HTMLElement;
  const provinciaBlock = document.getElementById(
    "provinciaBlock",
  ) as HTMLElement;
  const subtitle = document.getElementById("subtitle") as HTMLParagraphElement;
  const farmaciasList = document.getElementById("farmaciasList") as HTMLElement;
  const farmaciasVerMas = document.getElementById(
    "farmaciasVerMas",
  ) as HTMLButtonElement;
  const estacionesList = document.getElementById(
    "estacionesList",
  ) as HTMLElement;
  const zbsList = document.getElementById("zbsList") as HTMLElement;
  const hospitalesList = document.getElementById(
    "hospitalesList",
  ) as HTMLElement;
  const centrosList = document.getElementById("centrosList") as HTMLElement;
  const centrosVerMas = document.getElementById(
    "centrosVerMas",
  ) as HTMLButtonElement;

  if (!state.municipio) {
    noState.classList.remove("hidden");
  } else {
    noState.classList.add("hidden");
    zonaContent.classList.remove("hidden");

    const munNombre = state.municipio || "Sin datos";
    const provNombre = state.provincia || "Sin datos";
    subtitle.textContent = `${munNombre}, ${provNombre}`;
    municipioBlock.classList.remove("hidden");

    // FARMACIAS (con fallback a la ZBS si el municipio no tiene ninguna)
    const farmResult = obtenerFarmaciasConFallback(munNombre);
    const farmacias = farmResult.farmacias;
    if (farmacias.length === 0) {
      farmaciasList.innerHTML = `<p class="text-sm text-muted">No hay farmacias registradas en tu municipio ni en su Zona Básica de Salud.</p>`;
    } else {
      const aviso =
        farmResult.nivel === "zona"
          ? `<p class="text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-lg p-3 mb-3">No hay farmacias en tu municipio. Estas son las más cercanas dentro de tu Zona Básica de Salud:</p>`
          : "";
      const LIMITE = 8;
      const renderFarmacias = (lista: typeof farmacias) => {
        farmaciasList.innerHTML =
          aviso +
          lista
            .map((f) =>
              tarjeta(
                f.nombre,
                [f.direccion, f.cp ? `CP ${f.cp}` : ""],
                f.telefono,
              ),
            )
            .join("");
      };
      renderFarmacias(farmacias.slice(0, LIMITE));
      if (farmacias.length > LIMITE) {
        farmaciasVerMas.textContent = `Ver todas (${farmacias.length})`;
        farmaciasVerMas.classList.remove("hidden");
        farmaciasVerMas.addEventListener("click", () => {
          renderFarmacias(farmacias);
          farmaciasVerMas.classList.add("hidden");
        });
      }
    }

    // ESTACIONES DE BUS (con fallback a las más cercanas si no hay en el municipio)
    const estacionesResult = obtenerEstacionesCercanas(munNombre, 3);
    const estaciones = estacionesResult.estaciones;
    if (estaciones.length === 0) {
      estacionesList.innerHTML = `<p class="text-sm text-muted">No hay estaciones de autobús registradas cerca de tu municipio.</p>`;
    } else {
      const avisoEst =
        estacionesResult.nivel === "cercania"
          ? `<p class="text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-lg p-3 mb-3">No hay estación de autobuses en tu municipio. Estas son las más cercanas:</p>`
          : "";
      estacionesList.innerHTML =
        avisoEst +
        estaciones
          .map((e) =>
            tarjeta("Estación de autobuses", [e.direccion, e.municipio]),
          )
          .join("");
    }

    // ZONA BÁSICA DE SALUD
    const zbsResult = obtenerZbsMunicipio(munNombre);
    if (zbsResult && zbsResult.codigos.length > 0) {
      const zonas = zbsResult.codigos.map((codigo, index) => {
        const zona = obtenerZbs(codigo);
        const nombre = zona?.nombre || zbsResult.nombres[index] || `Zona ${codigo}`;
        const centrosZona = zona?.centros || [];
        const detalles = centrosZona.length > 0
          ? centrosZona.map((centro) => tarjeta(centro.nombre, [centro.direccion, centro.localidad])).join("")
          : `<p class="text-sm text-muted mt-2">No hay un centro de guardia asociado en los datos disponibles.</p>`;
        return `<div><p class="font-semibold text-fg">${escapeHtml(nombre)}</p><p class="text-xs text-muted mb-2">Código ${escapeHtml(codigo)}</p>${detalles}</div>`;
      });
      zbsList.innerHTML = zonas.join("");
      zbsBlock.classList.remove("hidden");
    } else {
      guiaSinZbs.classList.remove("hidden");
    }

    // PROVINCIA
    const municipioObj = obtenerMunicipio(munNombre);
    const provCode = municipioObj?.provincia || "";

    // HOSPITAL DE REFERENCIA PARA EL PARTO: la regla es dinámica —todo
    // hospital con nivel de urgencias II o superior en el dataset oficial—
    // y se elige el más cercano por distancia real, aunque esté en otra
    // provincia. Los demás hospitales se mantienen como recursos generales,
    // sin dar a entender que todos atienden partos.
    const hospitalParto = obtenerHospitalReferenciaParto(munNombre);
    const norm = (t: string) =>
      (t || "").toLocaleUpperCase("es").normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, " ").trim();
    const hospitalesConParto = obtenerHospitalesReferenciaParto();
    const nombresConParto = new Set(
      hospitalesConParto.flatMap((h) => [h.nombreUrgencias, h.nombreRegistro].filter(Boolean)).map((n) => norm(n as string))
    );
    const hospitales = obtenerHospitalesProvincia(provCode);
    const hospitalesSanitarios = obtenerHospitalesSanitariosProvincia(provCode);
    // El mismo hospital físico puede aparecer en los dos datasets con nombres
    // ligeramente distintos ("HOSPITAL DE MEDINA DEL CAMPO" en urgencias vs
    // "HOSPITAL MEDINA DEL CAMPO" en el registro): deduplicamos por nombre
    // normalizado sin artículos y conservamos la ficha del registro, que
    // lleva dirección y localidad.
    const normHospital = (t: string) =>
      norm(t).replace(/\b(DE|DEL|LA|EL|LOS|LAS)\b/g, "").replace(/\s+/g, " ").trim();
    const hospitalesRenderizados = [
      ...hospitales.map((h) => ({
        nombre: h.nombre,
        lineas: [h.nivel || ""],
      })),
      ...hospitalesSanitarios.map((h) => ({
        nombre: h.nombre,
        lineas: [h.direccion, h.localidad],
      })),
    ].filter((hospital, index, lista) =>
      lista.findLastIndex((otro) => normHospital(otro.nombre) === normHospital(hospital.nombre)) === index
    );
    const referenciaParto = hospitalParto
      ? `<div class="bg-emerald-50 border-2 border-emerald-600 rounded-lg p-4 mb-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-emerald-800 mb-1">Referencia para el parto</p>
          <p class="font-semibold text-fg">${escapeHtml(hospitalParto.nombreDisplay)}</p>
          <p class="text-sm text-muted mt-0.5">${escapeHtml(hospitalParto.localidad)} · a unos ${Math.round(hospitalParto.distanciaKm)} km en línea recta · ${escapeHtml(hospitalParto.nivel)}</p>
          ${hospitalParto.provincia !== provCode ? `<p class="text-sm text-emerald-900 mt-2">Es el hospital de referencia con paritorio más cercano, aunque está en otra provincia.</p>` : ""}
        </div>`
      : "";
    const otrosConPartoProvincia = hospitalesConParto.filter(
      (h) => h.provincia === provCode && hospitalParto && norm(h.nombreUrgencias) !== norm(hospitalParto.nombreUrgencias)
    );
    const tambienConParto = otrosConPartoProvincia.length
      ? `<p class="text-sm text-emerald-900 bg-emerald-50 border border-emerald-200 rounded-lg p-3 mb-3">También con paritorio en tu provincia: ${otrosConPartoProvincia.map((h) => escapeHtml(h.nombreDisplay)).join(", ")}.</p>`
      : "";
    const avisoHospitales = `<p class="text-sm text-muted bg-white border border-border rounded-lg p-3 mb-3"><strong>Importante:</strong> no todos los hospitales atienden partos. La referencia es el hospital de nivel II o superior más cercano según los datos oficiales de la Junta; los demás se muestran como recursos hospitalarios generales.</p>`;
    const otrosHospitales = hospitalesRenderizados.length === 0
      ? `<p class="text-sm text-muted">No hay otros hospitales registrados en tu provincia.</p>`
      : hospitalesRenderizados
          .filter((h) => !nombresConParto.has(norm(h.nombre)))
          .map((h) => tarjeta(h.nombre, h.lineas))
          .join("");
    hospitalesList.innerHTML = referenciaParto + tambienConParto + avisoHospitales + otrosHospitales;

    // CENTROS DE SALUD (municipio -> zona -> provincia, con aviso de nivel)
    const centrosResult = obtenerCentrosConFallback(munNombre, provCode);
    const centros = centrosResult.centros;
    const etiquetaNivel = {
      municipio: "en tu municipio",
      zona: "en tu Zona Básica",
      provincia: "en tu provincia",
    };
    if (centros.length === 0) {
      centrosList.innerHTML = `<p class="text-sm text-muted">No hay centros de salud con ubicación disponible cerca de ti.</p>`;
    } else {
      const aviso =
        centrosResult.nivel !== "municipio"
          ? `<p class="text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-lg p-3 mb-3">No hay centros de salud en tu municipio. Mostrando los disponibles ${etiquetaNivel[centrosResult.nivel]}:</p>`
          : "";
      const LIMITE_CENTROS = 8;
      const renderCentros = (lista: typeof centros) => {
        centrosList.innerHTML =
          aviso +
          lista
            .map((c) => tarjeta(c.nombre, [c.direccion, c.localidad, c.tipo]))
            .join("");
      };
      renderCentros(centros.slice(0, LIMITE_CENTROS));
      if (centros.length > LIMITE_CENTROS) {
        centrosVerMas.textContent = `Ver más (${centros.length} ${etiquetaNivel[centrosResult.nivel]})`;
        centrosVerMas.classList.remove("hidden");
        centrosVerMas.addEventListener("click", () => {
          renderCentros(centros);
          centrosVerMas.classList.add("hidden");
        });
      }
    }
    provinciaBlock.classList.remove("hidden");

    // MAPA (solo recursos con coordenadas reales: centros de salud/hospital y estaciones de bus)
    const mapaBlock = document.getElementById("mapaBlock") as HTMLElement;

    // Caja delimitadora aproximada de Castilla y León (con margen).
    // Cualquier coordenada fuera de esto es un dato corrupto del CSV
    // (p.ej. lat/lon invertidos) y se descarta en vez de mostrarse mal.
    const dentroDeCyL = (lat: number, lon: number) =>
      lat >= 39.5 && lat <= 43.5 && lon >= -7.5 && lon <= -1.5;

    const puntosMapa: Array<{
      lat: number;
      lon: number;
      nombre: string;
      tipo: string;
      detalle: string;
      propio: boolean;
    }> = [];

    // En el mapa mostramos todos los centros de la provincia (el filtro de
    // 20 km de más abajo deja solo los cercanos), no solo los del municipio.
    // Los del propio municipio van destacados con otro color.
    const claveCentro = (c: { nombre: string; localidad?: string }) =>
      `${c.nombre}|${c.localidad || ""}`.toLowerCase();
    const clavesPropias =
      centrosResult.nivel === "municipio"
        ? new Set(centrosResult.centros.map(claveCentro))
        : new Set<string>();
    const clavesVistas = new Set<string>();
    const centrosParaMapa = [
      ...centrosResult.centros,
      ...obtenerCentrosProvincia(provCode),
    ].filter((c) => {
      const clave = claveCentro(c);
      if (clavesVistas.has(clave)) return false;
      clavesVistas.add(clave);
      return true;
    });

    for (const c of centrosParaMapa) {
      if (c.coords && dentroDeCyL(c.coords[0], c.coords[1])) {
        puntosMapa.push({
          lat: c.coords[0],
          lon: c.coords[1],
          nombre: c.nombre,
          tipo: "centro",
          detalle: c.tipo || "",
          propio: clavesPropias.has(claveCentro(c)),
        });
      }
    }
    for (const e of estaciones) {
      if (e.coords && dentroDeCyL(e.coords[0], e.coords[1])) {
        puntosMapa.push({
          lat: e.coords[0],
          lon: e.coords[1],
          nombre: "Estación de autobuses",
          tipo: "estacion",
          detalle: e.direccion || "",
          propio: false,
        });
      }
    }

    const LIMITE_MAPA = 60;
    const origenMarcador = municipioObj?.coords || null;

    function distanciaKmMapa(a: [number, number], b: [number, number]): number {
      const R = 6371;
      const dLat = ((b[0] - a[0]) * Math.PI) / 180;
      const dLon = ((b[1] - a[1]) * Math.PI) / 180;
      const lat1 = (a[0] * Math.PI) / 180;
      const lat2 = (b[0] * Math.PI) / 180;
      const h =
        Math.sin(dLat / 2) ** 2 +
        Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLon / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(h));
    }

    let puntosMapaVisibles = puntosMapa;
    if (origenMarcador) {
      const RADIO_KM = 20;
      const conDistancia = puntosMapa
        .map((p) => ({ p, d: distanciaKmMapa(origenMarcador, [p.lat, p.lon]) }))
        .sort((a, b) => a.d - b.d);

      const dentroDelRadio = conDistancia.filter((x) => x.d <= RADIO_KM);
      // Si dentro del radio no hay ninguno (zona muy despoblada), al menos
      // muestra los 5 más cercanos que haya, aunque estén más lejos.
      puntosMapaVisibles = (
        dentroDelRadio.length > 0 ? dentroDelRadio : conDistancia.slice(0, 5)
      )
        .slice(0, LIMITE_MAPA)
        .map((x) => x.p);
    } else {
      puntosMapaVisibles = puntosMapa.slice(0, LIMITE_MAPA);
    }
    // Los centros del propio municipio se dibujan los últimos para que
    // queden por encima del resto de marcadores.
    puntosMapaVisibles = puntosMapaVisibles.sort(
      (a, b) => Number(a.propio) - Number(b.propio),
    );

    if (puntosMapaVisibles.length > 0) {
      mapaBlock.classList.remove("hidden");

      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css";
      document.head.appendChild(link);

      const script = document.createElement("script");
      script.src = "https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js";
      script.onload = () => {
        const maplibregl = (window as any).maplibregl;
        const mapEl = document.getElementById("map") as HTMLElement;

        const mapa = new maplibregl.Map({
          container: mapEl,
          style: {
            version: 8,
            sources: {
              satelite: {
                type: "raster",
                tiles: [
                  "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                ],
                tileSize: 256,
                attribution: "Tiles © Esri",
              },
            },
            layers: [{ id: "satelite", type: "raster", source: "satelite" }],
          },
          center: origenMarcador
            ? [origenMarcador[1], origenMarcador[0]]
            : [puntosMapaVisibles[0].lon, puntosMapaVisibles[0].lat],
          zoom: 14,
        });
        mapa.addControl(new maplibregl.NavigationControl(), "top-right");

        const bounds = new maplibregl.LngLatBounds();
        puntosMapaVisibles.forEach((p) => {
          bounds.extend([p.lon, p.lat]);

          const esCentro = p.tipo === "centro";
          const color = esCentro ? (p.propio ? "#d97706" : "#0f766e") : "#2563eb";
          const icono = esCentro ? "🏥" : "🚌";
          const tamano = p.propio ? 38 : 30;

          const el = document.createElement("div");
          el.style.cssText = `
            width: ${tamano}px; height: ${tamano}px;
            background: ${color};
            border: 2px solid white;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            box-shadow: ${p.propio ? "0 0 0 4px rgba(217,119,6,0.35), " : ""}0 2px 5px rgba(0,0,0,0.5);
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
          `;
          const iconoSpan = document.createElement("span");
          iconoSpan.textContent = icono;
          iconoSpan.style.cssText =
            "transform: rotate(45deg); font-size: 14px;";
          el.appendChild(iconoSpan);

          const comoLlegarUrl = `https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lon}`;
          const popupHtml = `
            <div style="min-width:180px">
              ${p.propio ? '<p style="font-size:11px;font-weight:700;color:#d97706;margin:0 0 2px">EN TU MUNICIPIO</p>' : ""}
              <p style="font-weight:600;margin:0 0 2px">${escapeHtml(p.nombre)}</p>
              <p style="font-size:12px;color:#64748b;margin:0 0 8px">${escapeHtml(p.detalle)}</p>
              <a href="${comoLlegarUrl}" target="_blank" rel="noopener"
                 style="font-size:12px;font-weight:600;color:${color};text-decoration:none">
                📍 Cómo llegar
              </a>
            </div>`;

          new maplibregl.Marker({ element: el, anchor: "bottom" })
            .setLngLat([p.lon, p.lat])
            .setPopup(new maplibregl.Popup({ offset: 20 }).setHTML(popupHtml))
            .addTo(mapa);
        });

        if (origenMarcador) {
          bounds.extend([origenMarcador[1], origenMarcador[0]]);

          const elOrigen = document.createElement("div");
          elOrigen.style.cssText = `
            width: 22px; height: 22px;
            background: #dc2626;
            border: 3px solid white;
            border-radius: 50%;
            box-shadow: 0 0 0 4px rgba(220,38,38,0.25), 0 2px 6px rgba(0,0,0,0.4);
          `;

          new maplibregl.Marker({ element: elOrigen, anchor: "center" })
            .setLngLat([origenMarcador[1], origenMarcador[0]])
            .setPopup(
              new maplibregl.Popup({ offset: 14 }).setHTML(
                `<p style="font-weight:600;margin:0">${escapeHtml(munNombre)}</p><p style="font-size:12px;color:#64748b;margin:0">Tu ubicación</p>`,
              ),
            )
            .addTo(mapa);
        }


        if (puntosMapaVisibles.length > 1) {
          mapa.fitBounds(bounds, { padding: 15, maxZoom: 19 });
        }
      };
      document.body.appendChild(script);
    }
  }
</script>
