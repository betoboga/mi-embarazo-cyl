---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  obtenerFarmaciasMunicipio,
  obtenerEstacionesMunicipio,
  obtenerHospitalesProvincia,
  obtenerCentrosProvincia,
  obtenerZbsMunicipio,
  obtenerMunicipio,
} from "../data/repository";
---

<Layout title="Tu zona sanitaria - Mi Embarazo CYL">
  <Header />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-8 sm:py-12 w-full">
    <div id="noState" class="hidden">
      <div
        class="bg-card border border-border rounded-xl p-6 sm:p-8 mx-auto text-center"
      >
        <div
          class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-bg-subtle mb-4"
        >
          <svg
            class="w-7 h-7 text-muted"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-fg mb-2">
          Selecciona un municipio
        </h2>
        <p class="text-muted">
          Elige tu municipio en la página principal para ver tus recursos
          sanitarios.
        </p>
        <a
          href="/donde-vive"
          class="mt-4 inline-block text-primary hover:text-primary-dark font-medium px-4 py-2 rounded-xl transition-colors"
          >Ir a donde vives</a
        >
      </div>
    </div>

    <div id="zonaContent" class="hidden">
      <div class="mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-fg mb-2">
          Tu zona sanitaria
        </h1>
        <p class="text-muted" id="subtitle"></p>
      </div>

      <div class="space-y-6">
        <div
          id="municipioBlock"
          class="bg-card border border-border rounded-xl p-6 sm:p-8 hidden"
        >
          <h3
            class="text-sm font-medium text-primary uppercase tracking-wider mb-3"
          >
            En tu municipio
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <p class="text-xs text-muted uppercase tracking-wider mb-1">
                Farmacias
              </p>
              <p class="text-3xl font-bold text-fg" id="munFarmacias">
                Cargando...
              </p>
            </div>
            <div>
              <p class="text-xs text-muted uppercase tracking-wider mb-1">
                Estaciones de bus
              </p>
              <p class="text-3xl font-bold text-fg" id="munEstaciones">
                Cargando...
              </p>
            </div>
          </div>
        </div>

        <div
          id="zbsBlock"
          class="bg-card border border-border rounded-xl p-6 sm:p-8 hidden"
        >
          <h3
            class="text-sm font-medium text-primary uppercase tracking-wider mb-3"
          >
            En tu Zona Básica
          </h3>
          <div id="zbsList"></div>
        </div>

        <div
          id="provinciaBlock"
          class="bg-bg-subtle border border-border rounded-xl p-6 sm:p-8 hidden"
        >
          <h3
            class="text-sm font-medium text-primary uppercase tracking-wider mb-3"
          >
            En tu provincia
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <p class="text-xs text-muted uppercase tracking-wider mb-1">
                Hospitales
              </p>
              <p class="text-3xl font-bold text-fg" id="provHospitales">
                Cargando...
              </p>
            </div>
            <div>
              <p class="text-xs text-muted uppercase tracking-wider mb-1">
                Centros de salud
              </p>
              <p class="text-3xl font-bold text-fg" id="provCentros">
                Cargando...
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  // Cliente: imports directos en el script (no frontmatter)
  import {
    obtenerFarmaciasMunicipio,
    obtenerEstacionesMunicipio,
    obtenerHospitalesProvincia,
    obtenerCentrosProvincia,
    obtenerZbsMunicipio,
    obtenerMunicipio,
  } from "../data/repository";

  // Estado desde localStorage (misma clave que donde-vive.astro)
  const STORAGE_KEY = "mi-embarazo-cyl-state";
  function getStoredState() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
    } catch {
      return {};
    }
  }

  const state = getStoredState();
  const noState = document.getElementById("noState") as HTMLElement;
  const zonaContent = document.getElementById("zonaContent") as HTMLElement;
  const municipioBlock = document.getElementById(
    "municipioBlock",
  ) as HTMLElement;
  const zbsBlock = document.getElementById("zbsBlock") as HTMLElement;
  const provinciaBlock = document.getElementById(
    "provinciaBlock",
  ) as HTMLElement;
  const subtitle = document.getElementById("subtitle") as HTMLParagraphElement;
  const munFarmacias = document.getElementById(
    "munFarmacias",
  ) as HTMLParagraphElement;
  const munEstaciones = document.getElementById(
    "munEstaciones",
  ) as HTMLParagraphElement;
  const zbsList = document.getElementById("zbsList") as HTMLElement;
  const provHospitales = document.getElementById(
    "provHospitales",
  ) as HTMLParagraphElement;
  const provCentros = document.getElementById(
    "provCentros",
  ) as HTMLParagraphElement;

  if (!state.municipio) {
    noState.classList.remove("hidden");
  } else {
    noState.classList.add("hidden");
    zonaContent.classList.remove("hidden");

    const munNombre = state.municipio || "Sin datos";
    const provNombre = state.provincia || "Sin datos";
    subtitle.textContent = `${munNombre}, ${provNombre}`;

    // 1. Farmacias (llamada síncrona - no usa .then())
    const farmacias = obtenerFarmaciasMunicipio(munNombre);
    munFarmacias.textContent =
      farmacias.length > 0 ? String(farmacias.length) : "No disponible";
    municipioBlock.classList.remove("hidden");

    // 2. Estaciones de bus (llamada síncrona - no usa .then/)
    const estaciones = obtenerEstacionesMunicipio(munNombre);
    munEstaciones.textContent =
      estaciones.length > 0 ? String(estaciones.length) : "No disponible";

    // 3. ZBS MUNICIPIO - mostrar TODAS las ZBS asociadas
    const zbsResult = obtenerZbsMunicipio(munNombre);
    if (zbsResult && zbsResult.codigos.length > 0) {
      const zbsHtml = zbsResult.codigos
        .map((code, i) => {
          const name = zbsResult.nombres[i] || `ZBS ${i + 1}`;
          return `<div class="bg-white p-2 rounded mb-1 text-sm"><strong>${code}</strong>: ${name}</div>`;
        })
        .join("");
      zbsList.innerHTML = zbsHtml;
      // Actualizar zbsNombre para retrocompatibilidad (mostrar cuántas ZBS hay)
      const zbsNombreEl = document.getElementById(
        "zbsNombre",
      ) as HTMLParagraphElement;
      if (zbsNombreEl) {
        zbsNombreEl.textContent =
          zbsResult.codigos.length > 1
            ? `${zbsResult.codigos.length} ZBS asociadas`
            : zbsResult.codigos[0];
      }
    } else {
      const zbsListInner = document.getElementById("zbsList") as HTMLElement;
      zbsList.innerHTML = "No disponibles";
    }

    // 4. Centros de la ZBS (NIVEL ACTUAL: provincia, no ZBS puRO)
    // ADVERTENCIA: repository.ts no tiene función distinta para centros por ZBS.
    // obtenerCentrosProvincia filtra por código de provincia (2 dígitos).
    // Como resultado, los centros mostrados aquí son de la provincia, no estrictamente de la ZBS.
    // Si se necesita filtrado puro por ZBS, requiere función nueva en repository.ts.
    const municipioObj = obtenerMunicipio(munNombre);
    const provCode = municipioObj?.provincia || "";
    const centros = obtenerCentrosProvincia(provCode);
    provCentros.textContent =
      centros.length > 0 ? String(centros.length) : "No disponible";

    // 5. Hospitales (llamada síncrona)
    const hospitales = obtenerHospitalesProvincia(provCode);
    provHospitales.textContent =
      hospitales.length > 0 ? String(hospitales.length) : "No disponible";

    // Mostrar todos los bloques
    zbsBlock.classList.remove("hidden");
    provinciaBlock.classList.remove("hidden");
  }
</script>
