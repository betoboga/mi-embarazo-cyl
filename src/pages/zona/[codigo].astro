---
import Layout from '../../layouts/Layout.astro';
import { getAllZoneCodes, getZoneData } from '../../data/datasets';

export function getStaticPaths() {
  return getAllZoneCodes().map((codigo) => ({
    params: { codigo },
    props: { zona: getZoneData(codigo) },
  }));
}

const { zona } = Astro.props;
if (!zona) throw new Error(`No existe la ZBS ${Astro.params.codigo}`);
const population = zona.poblacion?.toLocaleString('es-ES');
---
<Layout title={`${zona.nombre} · Mi Embarazo CYL`}>
  <main class="page">
    <a class="back" href="/donde-vives">← Cambiar municipio</a>

    <section class="hero">
      <span class="eyebrow">TU ZONA BÁSICA DE SALUD</span>
      <h1>{zona.nombre}</h1>
      <p>{zona.provincia}{zona.ambito ? ` · ${zona.ambito}` : ''}</p>
    </section>

    <section class="stats">
      <article>
        <span>POBLACIÓN DE REFERENCIA</span>
        <strong>{population ?? '—'}</strong>
        <small>{population ? 'ciudadanos' : 'dato no disponible en el CSV'}</small>
      </article>
      <article>
        <span>CÓDIGO ZBS</span>
        <strong>{zona.codigo}</strong>
        <small>identificador territorial</small>
      </article>
      <article>
        <span>MUNICIPIOS</span>
        <strong>{zona.municipios.length}</strong>
        <small>{zona.municipios.slice(0, 3).join(', ')}{zona.municipios.length > 3 ? '…' : ''}</small>
      </article>
    </section>

    <section class="resources">
      <div class="section-head">
        <span class="eyebrow">TU RED SANITARIA</span>
        <h2>Recursos localizados</h2>
        <p>Estamos cruzando los registros sanitarios para transformar los datos abiertos en información útil para una embarazada.</p>
      </div>

      <div class="resource-grid">
        <a class="resource" href="#centros"><span class="icon">+</span><div><strong>Centros de salud</strong><small>{zona.centros.length} localizados</small></div><span>↓</span></a>
        <a class="resource" href="#consultorios"><span class="icon">⌂</span><div><strong>Consultorios</strong><small>{zona.consultorios.length} asociados a la ZBS</small></div><span>↓</span></a>
        <a class="resource" href="#farmacias"><span class="icon">+</span><div><strong>Farmacias</strong><small>{zona.farmacias.length} en municipios de la zona</small></div><span>↓</span></a>
        <a class="resource" href="#urgencias"><span class="icon">!</span><div><strong>Atención urgente</strong><small>{zona.urgencias.length} recursos localizados</small></div><span>↓</span></a>
      </div>
    </section>

    <section class="data-section" id="centros">
      <div class="section-title"><span>01</span><h2>Centros de salud</h2></div>
      {zona.centros.length ? (
        <div class="list">
          {zona.centros.map((centro) => (
            <article class="item">
              <div><strong>{centro.nombre}</strong><small>{centro.localidad}{centro.tipo ? ` · ${centro.tipo}` : ''}</small></div>
              <p>{centro.direccion ?? 'Dirección no disponible'}{centro.cp ? ` · ${centro.cp}` : ''}</p>
              {centro.posicion && <small class="coords">📍 {centro.posicion}</small>}
            </article>
          ))}
        </div>
      ) : <p class="empty">No hemos podido establecer todavía una correspondencia segura entre esta ZBS y el registro de centros sanitarios.</p>}
    </section>

    <section class="data-section" id="consultorios">
      <div class="section-title"><span>02</span><h2>Consultorios</h2></div>
      {zona.consultorios.length ? (
        <div class="list">
          {zona.consultorios.map((consultorio) => (
            <article class="item compact">
              <div><strong>{consultorio.nombre}</strong><small>{consultorio.codigo ?? 'Código no disponible'}</small></div>
              {consultorio.centro ? <p>Centro asociado: {consultorio.centro}</p> : <p class="muted">Centro de referencia pendiente de cruce</p>}
            </article>
          ))}
        </div>
      ) : <p class="empty">No hay registros de consultorios disponibles para esta ZBS.</p>}
    </section>

    <section class="data-section" id="farmacias">
      <div class="section-title"><span>03</span><h2>Farmacias</h2></div>
      <p class="section-note">Las farmacias se relacionan por municipio/código postal, no directamente por ZBS. Por eso las mostramos como recursos de los municipios incluidos en esta zona.</p>
      {zona.farmacias.length ? (
        <div class="list two-cols">
          {zona.farmacias.map((farmacia) => (
            <article class="item compact"><strong>{farmacia.nombre}</strong><small>{farmacia.municipio}{farmacia.cp ? ` · ${farmacia.cp}` : ''}</small>{farmacia.direccion && <p>{farmacia.direccion}</p>}</article>
          ))}
        </div>
      ) : <p class="empty">No hay farmacias disponibles para los municipios identificados.</p>}
    </section>

    <section class="data-section" id="urgencias">
      <div class="section-title"><span>04</span><h2>Atención urgente</h2></div>
      {zona.urgencias.length ? (
        <div class="list">
          {zona.urgencias.map((recurso) => (
            <article class="item compact"><strong>{recurso.centro || 'Recurso sanitario'}</strong><small>{recurso.municipio}</small>{recurso.direccion && <p>{recurso.direccion}</p>}{recurso.horario && <small>{recurso.horario}</small>}</article>
          ))}
        </div>
      ) : <p class="empty">No hay recursos de atención urgente asociados de forma directa a esta ZBS en los datos disponibles.</p>}
    </section>

    <section class="notice">
      <span class="eyebrow">SIGUIENTE PASO</span>
      <h2>Ahora tenemos que convertir estos recursos en respuestas para la embarazada.</h2>
      <p>El siguiente bloque del MVP será el flujo de embarazo: semana de gestación, qué necesita la usuaria y qué recurso sanitario le corresponde.</p>
    </section>
  </main>
</Layout>

<style>
  :global(body){margin:0;background:#f8f7f4;color:#24231f;font-family:Inter,ui-sans-serif,system-ui,sans-serif}
  .page{max-width:960px;margin:auto;padding:32px 24px 100px}.back{color:#68705b;text-decoration:none;font-weight:700}
  .hero{padding:12vh 0 7vh}.eyebrow{font-size:.7rem;letter-spacing:.16em;color:#68705b;font-weight:800}.hero h1{font-size:clamp(3rem,8vw,6rem);letter-spacing:-.06em;line-height:.95;font-weight:500;margin:22px 0 12px}.hero p{color:#6d6a63;font-size:1.15rem}
  .stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1px;background:#d9d7d0;border:1px solid #d9d7d0}.stats article{background:#fff;padding:26px}.stats span{display:block;font-size:.67rem;letter-spacing:.12em;color:#858279;font-weight:800}.stats strong{display:block;font-size:1.8rem;margin-top:18px}.stats small{color:#88867e;line-height:1.4}
  .resources{padding:85px 0 20px}.section-head{max-width:680px}.section-head h2,.notice h2{font-size:clamp(2rem,4vw,3rem);letter-spacing:-.04em;line-height:1.05;font-weight:500;margin:16px 0}.section-head p,.notice p,.section-note{color:#74716a;line-height:1.6;font-size:1.05rem}
  .resource-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:35px}.resource{background:#fff;border:1px solid #dedcd5;border-radius:16px;padding:20px;display:grid;grid-template-columns:38px 1fr 20px;align-items:center;gap:12px;text-decoration:none;color:#24231f}.resource:hover{border-color:#aaa79e}.resource .icon{width:34px;height:34px;border-radius:50%;background:#eef0e8;color:#68705b;display:grid;place-items:center;font-weight:800}.resource strong,.resource small{display:block}.resource small{color:#88867e;margin-top:5px;font-size:.82rem}.resource>span:last-child{color:#68705b;font-weight:800}
  .data-section{padding:70px 0 0}.section-title{display:flex;align-items:baseline;gap:16px;border-bottom:1px solid #d9d7d0;padding-bottom:14px}.section-title span{font-size:.75rem;color:#8a887f}.section-title h2{font-size:2rem;letter-spacing:-.03em;font-weight:500;margin:0}.list{margin-top:12px;border-top:1px solid #ebe9e3}.two-cols{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#ebe9e3;border-top:0}.item{background:#fff;padding:20px}.item strong{font-size:1rem}.item small{display:block;color:#858279;margin-top:6px;line-height:1.45}.item p{color:#6f6c65;line-height:1.45;margin:10px 0 0}.item.compact{min-height:72px}.coords{font-family:ui-monospace,monospace;font-size:.75rem}.muted,.empty{color:#88867e!important}.empty{background:#fff;border:1px dashed #d3d1ca;padding:20px;margin-top:12px}.notice{margin-top:90px;padding:40px 0;border-top:1px solid #d9d7d0}.notice p{max-width:680px}
  @media(max-width:700px){.stats,.resource-grid,.two-cols{grid-template-columns:1fr}.hero{padding-top:9vh}.resources{padding-top:60px}}
</style>
