---
import Layout from '../../layouts/Layout.astro';
import { zbs } from '../../data/territorial';

export function getStaticPaths() {
  return zbs.map((zona) => ({ params: { codigo: zona.codigo }, props: { zona } }));
}

const { zona } = Astro.props;
---
<Layout title={`${zona.nombre} · Mi Embarazo CYL`}>
  <main class="page">
    <a class="back" href="/donde-vives">← Cambiar municipio</a>
    <section class="hero">
      <span class="eyebrow">TU ZONA BÁSICA DE SALUD</span>
      <h1>{zona.nombre}</h1>
      <p>{zona.provincia} · {zona.ambito}</p>
    </section>

    <section class="stats">
      <article><span>POBLACIÓN DE REFERENCIA</span><strong>{zona.poblacion.toLocaleString('es-ES')}</strong><small>ciudadanos</small></article>
      <article><span>CÓDIGO ZBS</span><strong>{zona.codigo}</strong><small>identificador territorial</small></article>
    </section>

    <section class="resources">
      <div class="section-head">
        <span class="eyebrow">TU RED SANITARIA</span>
        <h2>Lo que tenemos localizado en tu zona</h2>
        <p>Estamos conectando los distintos registros sanitarios para que no tengas que buscarlos por separado.</p>
      </div>
      <div class="resource-grid">
        <a class="resource" href="#centro"><span class="icon">+</span><div><strong>Centro de salud</strong><small>Referencia sanitaria</small></div><span>→</span></a>
        <a class="resource" href="#consultorios"><span class="icon">⌂</span><div><strong>Consultorios</strong><small>Centros de tu zona</small></div><span>→</span></a>
        <a class="resource" href="#farmacias"><span class="icon">+</span><div><strong>Farmacias</strong><small>Por municipio y código postal</small></div><span>→</span></a>
        <a class="resource" href="#urgencias"><span class="icon">!</span><div><strong>Urgencias</strong><small>Atención primaria urgente</small></div><span>→</span></a>
      </div>
    </section>

    <section class="notice">
      <span class="eyebrow">PRÓXIMO</span>
      <h2>Vamos a convertir estos datos en información útil para una embarazada.</h2>
      <p>El objetivo no es enseñar datasets: es responder preguntas concretas como dónde acudir, qué centro corresponde y qué recursos tiene cerca.</p>
    </section>
  </main>
</Layout>
<style>
  :global(body){margin:0;background:#f8f7f4;color:#24231f;font-family:Inter,ui-sans-serif,system-ui,sans-serif}
  .page{max-width:900px;margin:auto;padding:32px 24px 100px}.back{color:#68705b;text-decoration:none;font-weight:700}
  .hero{padding:12vh 0 7vh}.eyebrow{font-size:.7rem;letter-spacing:.16em;color:#68705b;font-weight:800}.hero h1{font-size:clamp(3rem,8vw,6rem);letter-spacing:-.06em;line-height:.95;font-weight:500;margin:22px 0 12px}.hero p{color:#6d6a63;font-size:1.15rem}
  .stats{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#d9d7d0;border:1px solid #d9d7d0}.stats article{background:#fff;padding:28px}.stats span{display:block;font-size:.67rem;letter-spacing:.12em;color:#858279;font-weight:800}.stats strong{display:block;font-size:2rem;margin-top:18px}.stats small{color:#88867e}
  .resources{padding:85px 0 20px}.section-head{max-width:650px}.section-head h2,.notice h2{font-size:clamp(2rem,4vw,3rem);letter-spacing:-.04em;line-height:1.05;font-weight:500;margin:16px 0}.section-head p,.notice p{color:#74716a;line-height:1.6;font-size:1.05rem}
  .resource-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:35px}.resource{background:#fff;border:1px solid #dedcd5;border-radius:16px;padding:20px;display:grid;grid-template-columns:38px 1fr 20px;align-items:center;gap:12px;text-decoration:none;color:#24231f;transition:transform .15s ease,border-color .15s ease}.resource:hover{transform:translateY(-2px);border-color:#aaa79e}.resource .icon{width:34px;height:34px;border-radius:50%;background:#eef0e8;color:#68705b;display:grid;place-items:center;font-weight:800}.resource strong,.resource small{display:block}.resource small{color:#88867e;margin-top:5px;font-size:.82rem}.resource>span:last-child{color:#68705b;font-weight:800}
  .notice{margin-top:80px;padding:40px 0;border-top:1px solid #d9d7d0}.notice p{max-width:650px}
  @media(max-width:650px){.stats,.resource-grid{grid-template-columns:1fr}.hero{padding-top:9vh}.resources{padding-top:60px}}
</style>
