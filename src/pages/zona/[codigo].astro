---
import Layout from '../../layouts/Layout.astro';
import { zbs } from '../../data/territorial';

export function getStaticPaths() {
  return zbs.map((zona) => ({ params: { codigo: zona.codigo }, props: { zona } }));
}

const { zona } = Astro.props;
---
<Layout title={`${zona.nombre} · Mi Embarazo CYL`}>
  <main class="page">
    <a class="back" href="/donde-vives">← Cambiar municipio</a>
    <section class="hero">
      <span class="eyebrow">TU ZONA BÁSICA DE SALUD</span>
      <h1>{zona.nombre}</h1>
      <p>{zona.provincia} · {zona.ambito}</p>
    </section>
    <section class="stats">
      <article><span>POBLACIÓN DE REFERENCIA</span><strong>{zona.poblacion.toLocaleString('es-ES')}</strong><small>ciudadanos</small></article>
      <article><span>CÓDIGO ZBS</span><strong>{zona.codigo}</strong><small>identificador territorial</small></article>
    </section>
    <section class="next">
      <span class="eyebrow">SIGUIENTE</span>
      <h2>Ahora vamos a localizar tus recursos sanitarios.</h2>
      <div class="todo">
        <div>✓</div><p><strong>Zona sanitaria</strong><br />Identificada mediante el código ZBS.</p>
        <div>→</div><p><strong>Centro de salud</strong><br />Conectaremos el registro sanitario y sus coordenadas.</p>
        <div>→</div><p><strong>Consultorio</strong><br />Relacionaremos los consultorios dependientes de tu centro.</p>
      </div>
    </section>
  </main>
</Layout>
<style>
  :global(body){margin:0;background:#f8f7f4;color:#24231f;font-family:Inter,ui-sans-serif,system-ui,sans-serif}
  .page{max-width:900px;margin:auto;padding:32px 24px 80px}.back{color:#68705b;text-decoration:none;font-weight:700}
  .hero{padding:12vh 0 7vh}.eyebrow{font-size:.72rem;letter-spacing:.16em;color:#68705b;font-weight:800}.hero h1{font-size:clamp(3rem,8vw,6rem);letter-spacing:-.06em;line-height:.95;font-weight:500;margin:22px 0 12px}.hero p{color:#6d6a63;font-size:1.15rem}
  .stats{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#d9d7d0;border:1px solid #d9d7d0}.stats article{background:#fff;padding:26px}.stats span{display:block;font-size:.68rem;letter-spacing:.12em;color:#858279;font-weight:800}.stats strong{display:block;font-size:2rem;margin-top:18px}.stats small{color:#88867e}
  .next{padding-top:70px}.next h2{font-size:2rem;letter-spacing:-.03em;max-width:620px;font-weight:500}.todo{margin-top:30px;border-top:1px solid #d9d7d0;display:grid;grid-template-columns:48px 1fr;align-items:center}.todo div,.todo p{padding:18px 0;border-bottom:1px solid #d9d7d0}.todo div{font-weight:800;color:#68705b}.todo p{margin:0;color:#74716a;line-height:1.45}.todo strong{color:#24231f}
  @media(max-width:650px){.stats{grid-template-columns:1fr}.hero{padding-top:9vh}}
</style>
