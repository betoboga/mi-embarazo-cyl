---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import nacimientos from "../data/nacimientos.json";
import nacimientosMunicipio from "../data/nacimientos_municipio.json";

const { anios, totalesCyL, porProvincia, resumen } = nacimientos as any;

// ---------- Gráfico de línea: evolución CyL ----------
const W = 720;
const H = 300;
const PAD = { top: 20, right: 20, bottom: 36, left: 56 };
const innerW = W - PAD.left - PAD.right;
const innerH = H - PAD.top - PAD.bottom;

const maxTotal = Math.max(...totalesCyL);
const yMax = Math.ceil(maxTotal / 5000) * 5000;

const px = (i: number) => PAD.left + (i / (anios.length - 1)) * innerW;
const py = (v: number) => PAD.top + innerH - (v / yMax) * innerH;

const linePath = totalesCyL
  .map(
    (v: number, i: number) =>
      `${i === 0 ? "M" : "L"}${px(i).toFixed(1)},${py(v).toFixed(1)}`,
  )
  .join(" ");

const areaPath =
  `M${px(0).toFixed(1)},${(PAD.top + innerH).toFixed(1)} ` +
  totalesCyL
    .map((v: number, i: number) => `L${px(i).toFixed(1)},${py(v).toFixed(1)}`)
    .join(" ") +
  ` L${px(anios.length - 1).toFixed(1)},${(PAD.top + innerH).toFixed(1)} Z`;

// Marcas del eje Y cada 5.000
const yTicks: number[] = [];
for (let v = 0; v <= yMax; v += 5000) yTicks.push(v);

// Marcas del eje X cada 5 años
const xTicks = anios
  .map((a: string, i: number) => ({ a, i }))
  .filter(({ a }: { a: string }) => Number(a) % 5 === 0);

// ---------- Gráfico de barras: último año por provincia ----------
const ultimoIdx = anios.length - 1;
const barras = porProvincia
  .map((p: any) => ({
    nombre: p.provinciaNombre,
    valor: p.valores[ultimoIdx],
    primero: p.valores[0],
  }))
  .sort((a: any, b: any) => b.valor - a.valor);

const maxBarra = Math.max(...barras.map((b: any) => b.valor));
---

<Layout title="Estadísticas de nacimientos - Mi Embarazo CYL">
  <Header />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-8 sm:py-12 w-full">
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-fg mb-2">
        Nacimientos en Castilla y León
      </h1>
      <p class="text-muted">
        Evolución desde {resumen.primerAnio} hasta {resumen.ultimoAnio}, por
        provincia.
      </p>
    </div>

    <!-- Cifras clave -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8">
      <div class="bg-card border border-border rounded-xl p-5">
        <p class="text-xs text-muted uppercase tracking-wider mb-1">
          En {resumen.ultimoAnio}
        </p>
        <p class="text-2xl font-bold text-fg">
          {resumen.nacimientosUltimoAnio.toLocaleString("es-ES")}
        </p>
        <p class="text-sm text-muted">nacimientos</p>
      </div>
      <div class="bg-card border border-border rounded-xl p-5">
        <p class="text-xs text-muted uppercase tracking-wider mb-1">
          Desde {resumen.primerAnio}
        </p>
        <p class="text-2xl font-bold text-fg">{resumen.variacionPct}%</p>
        <p class="text-sm text-muted">de variación</p>
      </div>
      <div
        class="bg-card border border-border rounded-xl p-5 col-span-2 sm:col-span-1"
      >
        <p class="text-xs text-muted uppercase tracking-wider mb-1">
          Mínimo histórico
        </p>
        <p class="text-2xl font-bold text-fg">
          {resumen.minimo.valor.toLocaleString("es-ES")}
        </p>
        <p class="text-sm text-muted">en {resumen.minimo.anio}</p>
      </div>
    </div>

    <!-- Evolución -->
    <section class="bg-card border border-border rounded-xl p-6 sm:p-8 mb-6">
      <h2
        class="text-sm font-medium text-primary uppercase tracking-wider mb-1"
      >
        Evolución en toda la comunidad
      </h2>
      <p class="text-sm text-muted mb-4">
        Nacimientos totales por año, {resumen.primerAnio}–{resumen.ultimoAnio}.
      </p>

      <div class="overflow-x-auto">
        <svg
          viewBox={`0 0 ${W} ${H}`}
          class="w-full h-auto min-w-[520px]"
          role="img"
          aria-label={`Gráfico de línea: los nacimientos pasaron de ${resumen.nacimientosPrimerAnio} en ${resumen.primerAnio} a ${resumen.nacimientosUltimoAnio} en ${resumen.ultimoAnio}`}
        >
          {
            yTicks.map((v) => (
              <g>
                <line
                  x1={PAD.left}
                  y1={py(v)}
                  x2={W - PAD.right}
                  y2={py(v)}
                  stroke="currentColor"
                  class="text-border"
                  stroke-width="1"
                />
                <text
                  x={PAD.left - 10}
                  y={py(v) + 4}
                  text-anchor="end"
                  font-size="11"
                  fill="currentColor"
                  class="text-muted"
                >
                  {v.toLocaleString("es-ES")}
                </text>
              </g>
            ))
          }

          <path d={areaPath} fill="#0f766e" opacity="0.10"></path>
          <path
            d={linePath}
            fill="none"
            stroke="#0f766e"
            stroke-width="2.5"
            stroke-linejoin="round"></path>

          <circle cx={px(0)} cy={py(totalesCyL[0])} r="4" fill="#0f766e"
          ></circle>
          <circle
            cx={px(ultimoIdx)}
            cy={py(totalesCyL[ultimoIdx])}
            r="4"
            fill="#0f766e"></circle>

          {
            xTicks.map(({ a, i }: { a: string; i: number }) => (
              <text
                x={px(i)}
                y={H - 12}
                text-anchor="middle"
                font-size="11"
                fill="currentColor"
                class="text-muted"
              >
                {a}
              </text>
            ))
          }
        </svg>
      </div>
    </section>

    <!-- Nacimientos por municipio -->
    <section class="bg-card border border-border rounded-xl p-6 sm:p-8 mb-6">
      <h2
        class="text-sm font-medium text-primary uppercase tracking-wider mb-1"
      >
        Busca tu municipio
      </h2>
      <p class="text-sm text-muted mb-4">
        Media de nacimientos por año en la última década (2015-2024).
      </p>

      <input
        type="text"
        id="buscadorMunicipio"
        placeholder="Escribe el nombre de tu municipio..."
        class="w-full px-4 py-2.5 rounded-lg border border-border bg-bg text-fg placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary/40"
        autocomplete="off"
      />

      <div id="resultadosMunicipio" class="mt-3 space-y-1"></div>
      <div id="natalidadResultado" class="mt-4 hidden"></div>
    </section>

    <!-- Por provincia -->
    <section class="bg-card border border-border rounded-xl p-6 sm:p-8 mb-6">
      <h2
        class="text-sm font-medium text-primary uppercase tracking-wider mb-1"
      >
        Por provincia en {resumen.ultimoAnio}
      </h2>
      <p class="text-sm text-muted mb-5">
        Nacimientos registrados en cada provincia durante el último año
        disponible.
      </p>

      <div class="space-y-3">
        {
          barras.map((b: any) => (
            <div>
              <div class="flex justify-between items-baseline mb-1">
                <span class="text-sm font-medium text-fg">{b.nombre}</span>
                <span class="text-sm text-muted">
                  {b.valor.toLocaleString("es-ES")}
                </span>
              </div>
              <div class="h-2.5 w-full bg-bg-subtle rounded-full overflow-hidden">
                <div
                  class="h-full rounded-full"
                  style={`width:${((b.valor / maxBarra) * 100).toFixed(1)}%;background:#0f766e`}
                ></div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <p class="text-xs text-muted">
      Fuente: {nacimientos.fuente}. Datos {resumen.primerAnio}–{
        resumen.ultimoAnio
      }.
    </p>
  </main>
  <Footer />

  <script>
  import { buscarMunicipios, obtenerMunicipio } from "../data/repository";
  import nacimientosMunicipio from "../data/nacimientos_municipio.json";

  function escapeHtml(s: string) {
    return (s || "").replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] || c)
    );
  }

  const input = document.getElementById("buscadorMunicipio") as HTMLInputElement;
  const resultados = document.getElementById("resultadosMunicipio") as HTMLElement;
  const natalidad = document.getElementById("natalidadResultado") as HTMLElement;
  const locale = window.location.pathname.startsWith("/ar")
    ? "ar"
    : window.location.pathname.startsWith("/en")
      ? "en"
      : "es";
  const copy = {
    es: {
      average: (name: string, media: string, total: string) =>
        `En ${name}, de media nacieron <strong>${media}</strong> niños al año entre 2015 y 2024 (${total} en total).`,
      total: (name: string, total: string) =>
        `En ${name} nacieron <strong>${total}</strong> niños en total entre 2015 y 2024.`,
      noneForMunicipality: (name: string) =>
        `No hay nacimientos registrados en <strong>${name}</strong> entre 2015 y 2024.`,
      noMunicipalities: "No se encontró ningún municipio.",
    },
    en: {
      average: (name: string, media: string, total: string) =>
        `In ${name}, an average of <strong>${media}</strong> children were born per year between 2015 and 2024 (${total} in total).`,
      total: (name: string, total: string) =>
        `In ${name}, <strong>${total}</strong> children were born in total between 2015 and 2024.`,
      noneForMunicipality: (name: string) =>
        `No births were recorded in <strong>${name}</strong> between 2015 and 2024.`,
      noMunicipalities: "No municipality found.",
    },
    ar: {
      average: (name: string, media: string, total: string) =>
        `في ${name}، وُلد في المتوسط <strong>${media}</strong> طفل سنوياً بين عامي 2015 و2024 (بإجمالي ${total}).`,
      total: (name: string, total: string) =>
        `في ${name}، وُلد ما مجموعه <strong>${total}</strong> طفلاً بين عامي 2015 و2024.`,
      noneForMunicipality: (name: string) =>
        `لا توجد ولادات مسجلة في <strong>${name}</strong> بين عامي 2015 و2024.`,
      noMunicipalities: "لم يتم العثور على بلدية.",
    },
  }[locale];
  const numberLocale = locale === "ar" ? "ar-EG" : locale === "en" ? "en-US" : "es-ES";

  function mostrarNatalidad(nombreMunicipio: string) {
    const mun = obtenerMunicipio(nombreMunicipio);
    const codigo5 = (mun as any)?.codigoIne?.substring(0, 5);
    const datos = codigo5 ? (nacimientosMunicipio as any).porMunicipio[codigo5] : null;

    natalidad.classList.remove("hidden");
    if (datos) {
      const media = datos.media10;
      const texto =
        media >= 1
          ? copy.average(escapeHtml(nombreMunicipio), media.toLocaleString(numberLocale), datos.total10.toLocaleString(numberLocale))
          : copy.total(escapeHtml(nombreMunicipio), datos.total10.toLocaleString(numberLocale));
      natalidad.innerHTML = `<div class="bg-bg-subtle border border-border rounded-lg p-4"><p class="text-fg">${texto}</p></div>`;
    } else {
      natalidad.innerHTML = `<div class="bg-bg-subtle border border-border rounded-lg p-4"><p class="text-fg">${copy.noneForMunicipality(escapeHtml(nombreMunicipio))}</p></div>`;
    }
    resultados.innerHTML = "";
    input.value = nombreMunicipio;
  }

  input.addEventListener("input", () => {
    const q = input.value.trim();
    natalidad.classList.add("hidden");
    if (q.length < 2) {
      resultados.innerHTML = "";
      return;
    }
    const municipios = buscarMunicipios(q).slice(0, 8);
    if (municipios.length === 0) {
      resultados.innerHTML = `<p class="text-sm text-muted">${copy.noMunicipalities}</p>`;
      return;
    }
    resultados.innerHTML = municipios
      .map(
        (m) =>
          `<button type="button" data-nombre="${escapeHtml(m.nombre)}" class="block w-full text-left px-3 py-2 rounded-lg hover:bg-bg-subtle text-fg text-sm">${escapeHtml(m.nombre)} <span class="text-muted">(${escapeHtml(m.provinciaNombre)})</span></button>`
      )
      .join("");

    resultados.querySelectorAll("button[data-nombre]").forEach((btn) => {
      btn.addEventListener("click", () => {
        mostrarNatalidad((btn as HTMLElement).dataset.nombre as string);
      });
    });
  });
</script>
</Layout>
