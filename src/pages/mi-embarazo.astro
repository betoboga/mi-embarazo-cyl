---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PregnancyNextSteps from '../components/PregnancyNextSteps.astro';
import NutritionGuide from '../components/NutritionGuide.astro';
---
<Layout title="Mi embarazo - CyLMaterna">
  <Header />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-8 sm:py-12 w-full">
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-fg mb-2">Tu embarazo</h1>
      <p class="text-muted" id="pageSubtitle">Cuéntanos un poco sobre tu embarazo.</p>
    </div>

    <details id="signos-sintomas-alarma" class="bg-card border-2 border-primary/20 rounded-xl p-6 sm:p-8 mb-4" aria-labelledby="signos-sintomas-alarma-title">
      <summary class="group cursor-pointer list-none [&::-webkit-details-marker]:hidden rounded-lg focus-visible:outline-3 focus-visible:outline-primary focus-visible:outline-offset-4" aria-expanded="false">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0" aria-hidden="true">
          <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86l-8.1 14a2 2 0 001.73 3h16.16a2 2 0 001.73-3l-8.1-14a2 2 0 00-3.46 0z" />
          </svg>
        </div>
        <div>
          <h2 id="signos-sintomas-alarma-title" class="text-xl sm:text-2xl font-bold text-fg">Signos y síntomas de alarma</h2>
          <p class="text-muted mt-1">Durante el embarazo, ciertos síntomas pueden indicar complicaciones y requieren de atención médica.</p>
          </div>
        </div>
        <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary group-hover:text-primary-dark">
          <span data-details-label>Ver más</span>
          <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </summary>

      <div class="mt-6 space-y-7 text-fg leading-relaxed">
        <div>
          <h3 class="text-lg font-semibold text-fg mb-3">Síntomas que requieren atención médica</h3>
          <ul class="list-disc pl-5 space-y-2">
            <li><strong>Sangrado vaginal:</strong> un leve manchado puede ser normal, pero ante un sangrado abundante acompañado de dolor es importante acudir a urgencias hospitalarias, especialmente durante el tercer trimestre.</li>
            <li>Dolor abdominal intenso o persistente.</li>
            <li>Fiebre (temperatura superior a 38º)</li>
            <li>Dolor de cabeza intenso y cambios en la visión</li>
            <li>Mareos desmayos o pérdida de conciencia</li>
            <li>Hinchazón súbita de manos, cara o pies, especialmente si se acompaña de dolor de cabeza o cambios en la visión.</li>
            <li>Disminución de movimientos fetales, a partir de la semana 20.</li>
            <li>Contracciones regulares o dolorosas antes de la semana 37</li>
            <li>Vómitos incontrolables persistentes</li>
            <li>Sensación de pérdida de líquido</li>
            <li>Pensamientos acerca de hacerse daños o hacerle daño al bebé</li>
          </ul>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-fg mb-3">A partir de la semana 37:</h3>
          <ul class="list-disc pl-5 space-y-3">
            <li>
              <span>Contracciones</span>
              <ul class="list-[circle] pl-5 mt-2 space-y-2">
                <li><strong>Si es mi primer hijo:</strong> regulares cada 3-4 minutos, que duran entre 30 y 60 segundos y que no ceden tras al menos 1 hora.</li>
                <li><strong>Si ya he tenido un parto o más:</strong> cuando sean regulares cada 3-4 minutos y no ceden, especialmente si aumentan de intensidad o si tardo 1h o más en llegar al hospital de referencia.</li>
              </ul>
            </li>
            <li>
              <span>Si noto pérdida de líquido --&gt; observo el color del líquido:</span>
              <ul class="list-[circle] pl-5 mt-2 space-y-2">
                <li><strong>Líquido claro/transparente:</strong> preparo las cosas y voy tranquilamente al hospital</li>
                <li><strong>Líquido verde, marrón o mal olor:</strong> debo ir con urgencia al hospital</li>
              </ul>
            </li>
            <li>Si se mueve menos de lo normal o no se mueve</li>
            <li>Si sangrado vaginal (ligero flujo o moco sanguinolento es normal)</li>
          </ul>
        </div>

        <div class="bg-primary-light border-l-4 border-primary rounded-r-lg p-4 sm:p-5">
          <p>Recuerda que debes conocer tu fecha de última regla y si tu embarazo tiene algún factor de riesgo para poder facilitar la atención.</p>
        </div>

        <div class="space-y-3">
          <p>Intenta planificar el traslado al hospital con antelación, sobre todo si vives en una zona rural y recuerda llevar tu documentación médica (especialmente si te has controlado el embarazo en otro hospital).</p>
          <p>En caso de haber llevado el control en el extranjero, nos sería especialmente útil tener los informes impresos y traducidos.</p>
        </div>
      </div>
    </details>

    <details id="atencion-embarazo" class="bg-card border-2 border-secondary/20 rounded-xl p-6 sm:p-8 mb-4" aria-labelledby="atencion-embarazo-heading">
      <summary class="group cursor-pointer list-none [&::-webkit-details-marker]:hidden rounded-lg focus-visible:outline-3 focus-visible:outline-primary focus-visible:outline-offset-4" aria-expanded="false">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 rounded-lg bg-secondary-light flex items-center justify-center shrink-0" aria-hidden="true">
          <svg class="w-5 h-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-3-3v6m8-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h2 id="atencion-embarazo-heading" class="text-xl sm:text-2xl font-bold text-fg">Atención y seguimiento del embarazo</h2>
          <p class="text-muted mt-1">El proceso de atención al embarazo desde atención primaria actualmente se desarrolla con un enfoque multidisciplinar, centrado en las necesidades de la mujer, la familia y garantizando la continuidad en la asistencia.</p>
          </div>
        </div>
        <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-secondary group-hover:text-primary-dark">
          <span data-details-label>Ver más</span>
          <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </summary>

      <div class="mt-6 space-y-7 text-fg leading-relaxed">
        <p>El seguimiento del embarazo se lleva a cabo entre atención primaria y atención especializada, con los compañeros ginecólogos en el hospital. Además, se irán realizando varios controles analíticos durante el embarazo.</p>

        <div>
          <h3 class="text-lg font-semibold text-fg mb-3">Consulta preconcepcional</h3>
          <div class="space-y-3">
            <p>Acudir a la consulta de la matrona si se está <strong>planeando</strong> embarazo es ideal para conocer su estado de salud previo, la existencia de enfermedades que requieran un control adecuado e iniciar acciones de educación sanitaria.</p>
            <p>Se deben iniciar medidas de prevención de los defectos del tubo neural entre 3-4 meses <strong>antes</strong> de la concepción (toma de <strong>ácido fólico y yodo</strong>).</p>
            <p>El objetivo de esta consulta es prevenir las complicaciones y un mejor desarrollo del embarazo.</p>
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-fg mb-3">Primera consulta de la matrona</h3>
          <p><strong>¿Cuándo?</strong> En cuanto te enteras de que estás embarazada.</p>
          <p class="mt-3">El resto de las consultas serán citadas por tu matrona correspondiente.</p>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-fg mb-3">Citas en la consulta de Obstetricia (en el hospital)</h3>
          <div class="space-y-3">
            <p>En embarazos de bajo riesgo se llevarán a cabo tres ecografías, su asistencia es de vital importancia.</p>
          </div>
        </div>

        <div class="grid gap-3" aria-label="Información importante sobre el seguimiento">
          <div class="bg-secondary-light border-l-4 border-secondary rounded-r-lg p-4">
            <h3 class="font-semibold text-fg">Sin olvidar las analíticas de control.</h3>
          </div>
          <div class="bg-secondary-light border-l-4 border-secondary rounded-r-lg p-4">
            <h3 class="font-semibold text-fg">Si has empezado a controlar el embarazo tarde y vienes de hacerlo en otro centro, contacta cuanto antes con la matrona de tu centro de salud.</h3>
          </div>
          <div class="bg-secondary-light border-l-4 border-secondary rounded-r-lg p-4">
            <h3 class="font-semibold text-fg">Además puedes consultar en cualquier momento con tu matrona información sobre clases de educación maternal, prenatal y clases de preparación al parto.</h3>
          </div>
          <div class="bg-primary-light border-l-4 border-primary rounded-r-lg p-4">
            <h3 class="font-semibold text-fg mb-2">Jornadas de Acogida del hospital</h3>
            <p class="text-fg">Algunos hospitales organizan visitas al paritorio para que puedas conocer los espacios, entender cómo funciona la atención y resolver tus dudas antes del parto. Pregunta a tu matrona o a tu hospital de referencia si ofrecen estas jornadas y cómo apuntarte.</p>
          </div>
        </div>

        <div class="bg-secondary-light border-l-4 border-secondary rounded-r-lg p-4 sm:p-5">
          <p class="mb-4">Para conocer detalladamente cuál va a ser el seguimiento de tu embarazo ponte en contacto con tu matrona de referencia.</p>
          <a href="/donde-vive" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-primary-dark text-white font-medium px-5 py-3 rounded-xl transition-colors no-underline focus-visible:outline-3 focus-visible:outline-secondary focus-visible:outline-offset-3">
            ¿Cuál es mi matrona de referencia?
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </details>

    <details id="site" class="bg-card border-2 border-primary/20 rounded-xl p-6 sm:p-8 mb-8" aria-labelledby="site-heading">
      <summary class="group cursor-pointer list-none [&::-webkit-details-marker]:hidden rounded-lg focus-visible:outline-3 focus-visible:outline-primary focus-visible:outline-offset-4" aria-expanded="false">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0" aria-hidden="true">
          <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9.247a4.75 4.75 0 117.544 0M12 14v.01M12 18h.01M5.636 5.636l-.707-.707m14.142.707l.707-.707M12 2v1" />
          </svg>
        </div>
        <div>
          <h2 id="site-heading" class="text-xl sm:text-2xl font-bold text-fg">¿Has estado en contacto con sustancias peligrosas o factores de riesgo?</h2>
          <p class="text-muted mt-1">Servicio de Información Telefónica para la Embarazada (SITE)</p>
          </div>
        </div>
        <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary group-hover:text-primary-dark">
          <span data-details-label>Ver más</span>
          <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </summary>

      <div class="mt-6 space-y-5 text-fg leading-relaxed">
        <p><strong>El SITE</strong> es un servicio de información sobre factores de riesgo para el desarrollo del niño antes del nacimiento.</p>
        <p>Las embarazadas pueden recibir información telefónica llamando al teléfono <a href="tel:918222436" class="font-bold text-primary hover:text-primary-dark underline underline-offset-2">91 822 24 36</a>, <strong>en horario de 9 a 15 horas de lunes a viernes</strong>.</p>
        <p>Serán atendidas por médicos especialistas pertenecientes al grupo científico de la asociación Estudio Colaborativo Español de Malformaciones Congénitas (ECEMC), quienes responderán sobre los peligros para el embrión o feto de los diferentes agentes ambientales (químicos/tratamientos farmacológicos, físicos, biológicos, …) que pueden afectar a la mujer embarazada, así como sobre aquellas otras cuestiones relacionadas con el cuidado y atención del embarazo.</p>

        <div class="bg-primary-light border-l-4 border-primary rounded-r-lg p-4 sm:p-5">
          <p class="font-semibold text-fg mb-2">Información de contacto</p>
          <p class="text-fg">Teléfono SITE: <a href="tel:918222436" class="text-primary hover:text-primary-dark underline underline-offset-2 font-bold">91 822 24 36</a></p>
          <p class="text-fg">Horario: de 9 a 15 horas, de lunes a viernes</p>
        </div>
      </div>
    </details>

    <NutritionGuide />

    <div id="formSection">
      <div class="bg-card border border-border rounded-xl p-6 sm:p-8">
        <h2 class="text-lg font-semibold text-fg mb-6">¿Cuánto tiempo llevas?</h2>
        <form id="embarazoForm">
          <div class="mb-6">
            <label for="semanaSelect" class="block text-sm font-medium text-fg mb-2">Semanas de embarazo</label>
            <select id="semanaSelect" class="w-full px-4 py-3 text-base bg-white border-2 border-border rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all appearance-none cursor-pointer">
              <option value="">Selecciona...</option>
            </select>
          </div>
          <div class="mb-8">
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" id="primerEmbarazo" class="w-5 h-5 rounded border-border text-primary focus:ring-primary/20 cursor-pointer" />
              <span class="text-sm text-fg">Es mi primer embarazo</span>
            </label>
          </div>
          <button type="submit" class="w-full bg-primary hover:bg-primary-dark text-white font-medium px-6 py-3 rounded-xl transition-colors">
            Guardar
          </button>
        </form>
      </div>
    </div>

    <div id="dashboardSection" class="hidden">
      <div class="space-y-6">
        <div class="bg-card border border-border rounded-xl p-6">
          <div class="flex items-center justify-between mb-4">
            <div>
              <p class="text-sm text-muted">Semana actual</p>
              <p class="text-3xl font-bold text-primary" id="dashSemana">—</p>
            </div>
            <div class="text-right">
              <p class="text-sm text-muted">Progreso</p>
              <p class="text-3xl font-bold text-fg" id="dashProgreso">—</p>
            </div>
          </div>
          <div class="w-full h-3 bg-bg-subtle rounded-full overflow-hidden">
            <div class="h-full bg-primary rounded-full transition-all duration-500" id="dashBar" style="width: 0%"></div>
          </div>
          <p class="text-xs text-muted mt-3" id="dashTrimestre"></p>
        </div>

        <div id="zonaCard" class="bg-card border border-border rounded-xl p-6 hidden">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-sm text-muted">Tu zona sanitaria</p>
              <p class="font-semibold text-fg" id="dashZbs">—</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-xs text-muted uppercase tracking-wider mb-1">Municipio</p>
              <p class="font-medium text-fg" id="dashMunicipio">—</p>
            </div>
            <div>
              <p class="text-xs text-muted uppercase tracking-wider mb-1">Codigo ZBS</p>
              <p class="font-mono font-medium text-primary" id="dashCodigo">—</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-lg font-semibold text-fg mb-4">Tus recursos</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4" id="dashResources"></div>
        </div>

        <div class="bg-bg-subtle border border-border rounded-xl p-5">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-muted mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-sm text-muted">Consulta siempre las indicaciones de tu matrona o profesional sanitario. Esta información es complementaria.</p>
          </div>
        </div>

        <button id="editBtn" class="w-full bg-transparent border-2 border-border text-muted hover:text-fg hover:border-primary/30 font-medium px-6 py-3 rounded-xl transition-colors">
          Modificar datos
        </button>
      </div>

{/* PREGNANCY NEXT STEPS SECTION */}
  <PregnancyNextSteps />
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import data from '../data/territorial.json';

  const STORAGE_KEY = 'mi-embarazo-cyl-state';

  // Los <details> conservan la interacción nativa por teclado. Sincronizamos
  // el estado y el texto para que el control sea claro también para lectores de pantalla.
  document.querySelectorAll<HTMLDetailsElement>('main > details').forEach((details) => {
    const summary = details.querySelector<HTMLElement>('summary');
    const label = details.querySelector<HTMLElement>('[data-details-label]');
    if (!summary || !label) return;

    const syncExpandedState = () => {
      summary.setAttribute('aria-expanded', String(details.open));
      label.textContent = details.open ? 'Ver menos' : 'Ver más';
    };

    details.addEventListener('toggle', syncExpandedState);
    syncExpandedState();
  });

  // Función segura para obtener el estado (maneja SSR donde localStorage no existe)
  function getStoredState(): any {
    // @ts-ignore - localStorage solo existe en el navegador
    if (typeof localStorage === 'undefined') {
      return { semana: 0 };
    }
    try { 
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); 
    } catch { 
      return { semana: 0 }; 
    }
  }

  const state = getStoredState();
  const formSection = document.getElementById('formSection') as HTMLElement;
  const dashboardSection = document.getElementById('dashboardSection') as HTMLElement;
  const semanaSelect = document.getElementById('semanaSelect') as HTMLSelectElement;
  const primerEmbarazo = document.getElementById('primerEmbarazo') as HTMLInputElement;
  const editBtn = document.getElementById('editBtn') as HTMLButtonElement;
  const embarazoForm = document.getElementById('embarazoForm') as HTMLFormElement;

  for (let i = 1; i <= 42; i++) {
    const opt = document.createElement('option');
    opt.value = String(i);
    opt.textContent = `Semana ${i}`;
    semanaSelect.appendChild(opt);
  }

  if (state.semana && state.semana > 0) {
    showDashboard();
  }

  embarazoForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const semana = parseInt(semanaSelect.value);
    if (!semana || semana < 1 || semana > 42) return;
    state.semana = semana;
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    showDashboard();
  });

  editBtn.addEventListener('click', () => {
    formSection.classList.remove('hidden');
    dashboardSection.classList.add('hidden');
    if (state.semana) semanaSelect.value = String(state.semana);
    if (state.primerEmbarazo) document.getElementById('primerEmbarazo')!.checked = true;
  });

  function showDashboard() {
    formSection.classList.add('hidden');
    dashboardSection.classList.remove('hidden');

    const semana = state.semana || 1;
    const progreso = Math.round((semana / 40) * 100);
    const trimestre = semana <= 12 ? 'Primer trimestre' : semana <= 27 ? 'Segundo trimestre' : 'Tercer trimestre';

    document.getElementById('pageSubtitle')!.textContent = `Semana ${semana} de 40`;
    document.getElementById('dashSemana')!.textContent = `${semana} / 40`;
    document.getElementById('dashProgreso')!.textContent = `${progreso}%`;
    document.getElementById('dashBar')!.style.width = `${progreso}%`;
    document.getElementById('dashTrimestre')!.textContent = trimestre;

    if (state.municipio) {
      document.getElementById('zonaCard')!.classList.remove('hidden');
      document.getElementById('dashZbs')!.textContent = state.zbsNombre || 'Sin datos';
      document.getElementById('dashMunicipio')!.textContent = state.municipio;
      document.getElementById('dashCodigo')!.textContent = state.codigoZbs || '—';
    }

    const normalize = (s: string) => (s || '').trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, ' ');
    const municipioNorm = normalize(state.municipio || '');
    const provCode = state.codigoZbs ? state.codigoZbs.substring(0, 2) : '';

    const farmacias = data.farmacias.filter((f: any) => normalize(f.municipio) === municipioNorm);
    const estacionesBus = data.estacionesBus.filter((b: any) => normalize(b.municipio) === municipioNorm);
    const hospitales = data.hospitales.filter((h: any) => h.provincia === provCode);

    const resources = [
      { title: 'Farmacias', value: farmacias.length, icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" },
      { title: 'Hospitales', value: hospitales.length, icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" },
